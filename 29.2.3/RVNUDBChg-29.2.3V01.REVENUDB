--Subhani

IF NOT EXISTS(SELECT 1 FROM SYS.TABLES TAB 
LEFT JOIN SYS.COLUMNS SCO ON TAB.object_id=SCO.object_id
WHERE TAB.NAME='COM_UOM' AND SCO.Name='DimKey')
BEGIN
	ALTER TABLE [dbo].[COM_UOM] ADD DimKey  int
END



IF NOT EXISTS(SELECT 1 FROM SYS.TABLES TAB 
LEFT JOIN SYS.COLUMNS SCO ON TAB.object_id=SCO.object_id
WHERE TAB.NAME='COM_UOMHISTORY' AND SCO.Name='DimKey')
BEGIN
	ALTER TABLE [dbo].[COM_UOMHISTORY] ADD DimKey  int
END