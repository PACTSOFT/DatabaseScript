--Sajid
DECLARE @RId BIGINT
SELECT @RId=max(ResourceID) From [COM_LanguageResources] with(nolock)

set @RId=@RId+1

IF NOT EXISTS(SELECT Name FROM [COM_CostCenterPreferences] WITH(NOLOCK) WHERE CostCenterID=95 and Name='DistributeChequeAmount')
BEGIN

	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@RId,'DistributeChequeAmount',1,'English','Distribute Cheque Amount','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',CONVERT(float,getdate()),NULL,NULL,'')

	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@RId,'DistributeChequeAmount',2,'Arabic','Distribute Cheque Amount-AR','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',CONVERT(float,getdate()),NULL,NULL,'')


	INSERT [dbo].[COM_CostCenterPreferences] ([CostCenterID], [FeatureID], [ResourceID], [Name], [Value], [DefaultValue], [ProbableValues], [GUID], [Description], [CreatedBy], [CreatedDate], [ModifiedBy], [ModifiedDate]) 
	VALUES (95, 95, @RId, N'DistributeChequeAmount', N'False', N'False', NULL, N'guid', NULL, N'admin', convert(float,getdate()), NULL, NULL)

END
