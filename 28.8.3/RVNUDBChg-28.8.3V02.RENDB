DECLARE @RId BIGINT
SELECT @RId=ResourceID From [COM_LanguageResources] with(nolock)

set @RId=@RId+1

IF NOT EXISTS(SELECT Name FROM [COM_CostCenterPreferences] WITH(NOLOCK) WHERE CostCenterID=95 and Name='AddressBasedOn')
BEGIN

	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@RId,'AddressBasedOn',1,'English','Address Based On','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',4.072966253163580e+004,NULL,NULL,'')

	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@RId,'AddressBasedOn',2,'Arabic','Address Based On-AR','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',4.072966253163580e+004,NULL,NULL,'')


	INSERT [dbo].[COM_CostCenterPreferences] ([CostCenterID], [FeatureID], [ResourceID], [Name], [Value], [DefaultValue], [ProbableValues], [GUID], [Description], [CreatedBy], [CreatedDate], [ModifiedBy], [ModifiedDate]) 
	VALUES (95, 95, @RId, N'AddressBasedOn', N'', N'', NULL, N'guid', NULL, N'admin', convert(float,getdate()), NULL, NULL)

	INSERT [dbo].[COM_CostCenterPreferences] ([CostCenterID], [FeatureID], [ResourceID], [Name], [Value], [DefaultValue], [ProbableValues], [GUID], [Description], [CreatedBy], [CreatedDate], [ModifiedBy], [ModifiedDate]) 
	VALUES (103, 103, @RId, N'AddressBasedOn', N'', N'', NULL, N'guid', NULL, N'admin', convert(float,getdate()), NULL, NULL)

	INSERT [dbo].[COM_CostCenterPreferences] ([CostCenterID], [FeatureID], [ResourceID], [Name], [Value], [DefaultValue], [ProbableValues], [GUID], [Description], [CreatedBy], [CreatedDate], [ModifiedBy], [ModifiedDate]) 
	VALUES (104, 104, @RId, N'AddressBasedOn', N'', N'', NULL, N'guid', NULL, N'admin', convert(float,getdate()), NULL, NULL)

	INSERT [dbo].[COM_CostCenterPreferences] ([CostCenterID], [FeatureID], [ResourceID], [Name], [Value], [DefaultValue], [ProbableValues], [GUID], [Description], [CreatedBy], [CreatedDate], [ModifiedBy], [ModifiedDate]) 
	VALUES (129, 129, @RId, N'AddressBasedOn', N'', N'', NULL, N'guid', NULL, N'admin', convert(float,getdate()), NULL, NULL)
END

