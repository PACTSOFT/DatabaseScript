				set @Sql=@Sql+'', B.BILLNO, Convert(DATETIME, B.Billdate), a.CommonNarration,B.Narration, a.ChequeBankName,a.CostCenterID, DocAbbr,DocPrefix,Docnumber,  
				  a.ChequeNumber, a.ChequeDate,a.ChequeMaturityDate''
				if(@inclfrmdoc=1)
