--KHASIM

DECLARE @FeatureActionID bigint,@FROMCCID INT,@TOCCID INT,@Rid INT
SELECT @TOCCID=MAX(COSTCENTERID) FROM ADM_DOCUMENTTYPES WITH(NOLOCK)
SELECT @Rid=MAX(ResourceID) from COM_LanguageResources WITH(NOLOCK)
SET @Rid=@Rid+1
SET @FROMCCID=40000

INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
VALUES(@Rid,'LinkMap',1,'English','Map',NEWID(),NULL,'ADMIN',convert(float,getdate()),NULL,NULL,'FeatureAction')

WHILE(@FROMCCID<=@TOCCID)
BEGIN		
 IF ((SELECT COUNT(*) FROM ADM_DOCUMENTTYPES WITH(NOLOCK) WHERE COSTCENTERID=@FROMCCID)>0)
 BEGIN
	IF NOT EXISTS(SELECT Name FROM [ADM_FeatureAction] WITH(NOLOCK) WHERE FeatureID=@FROMCCID AND [Name]='Map')
	BEGIN
		INSERT INTO [ADM_FeatureAction] ([Name],[ResourceID],[FeatureID],[FeatureActionTypeID],[ApplicationID],[GridShortCut],[Description],[Status],[CreatedDate],[CreatedBy])
		VALUES('Map',@Rid,@FROMCCID,915,1,NULL,NULL,1,CONVERT(FLOAT,GETDATE()),'ADMIN')
		SET @FeatureActionID=@@IDENTITY
		INSERT INTO [ADM_FeatureActionRoleMap]([RoleID],[FeatureActionID],[Description],[Status],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate])
		VALUES( 1,@FeatureActionID,'LinkMap',1,'Admin',CONVERT(FLOAT,GETDATE()),NULL,NULL )			
	END
 END	
SET @FROMCCID=@FROMCCID+1
END