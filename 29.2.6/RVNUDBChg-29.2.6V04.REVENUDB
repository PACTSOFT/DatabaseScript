update INV_GSTMapping set DefColumnName='acAlpha51',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='VATNumber_Delivery'
update INV_GSTMapping set DefColumnName='Address1',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='AddressLine1_Delivery'
update INV_GSTMapping set DefColumnName='Address2',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='AddressLine2_Delivery'
update INV_GSTMapping set DefColumnName='Address3',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='AddressLine3_Delivery'
update INV_GSTMapping set DefColumnName='City',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='City_Delivery'
update INV_GSTMapping set DefColumnName='CCNID59',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='State_Delivery'
update INV_GSTMapping set DefColumnName='Zip',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='PostCode_Delivery'
