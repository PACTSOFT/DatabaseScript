update INV_GSTMapping set DefColumnName='dcCCNID91'  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='GoodsandServicesType'
update INV_GSTMapping set DefColumnName='dcCCNID71'  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='ItemType'

update INV_GSTMapping set DefColumnName='AddressName',DefReference=2  where CostCenterID=0 and GSTType='UAEUBL' and GSTColumnName='PartyName_Delivery'
