-- SHASHANK


update ADM_RevenUReports set Query='
DECLARE @IsGradeWiseMP BIT,@CARRYFORWARD NVARCHAR(100),@GRADE INT,@LeaveType INT,@I INT,@CNT INT,@EMPNODE INT,@ASONDATE DATETIME,@AvailInProbation NVARCHAR(50),@ShowInESS NVARCHAR(50),@ShowVacation nvarchar(50),@VacationName nvarchar(500),@vCompID bigint,@Gender nvarchar(100),@GenderBasedOn nvarchar(100),@GenderApplicable NVARCHAR(50),@MaxLeaves FLOAT

DECLARE  @TAB TABLE(ID INT IDENTITY(1,1),NODEID INT,CODE NVARCHAR(500),NAME NVARCHAR(500),LEAVETYPE NVARCHAR(500),LEAVEYEAR DATETIME,OPENINGBALANCE FLOAT,ASSIGNEDLEAVES FLOAT,DEDUCTEDLEAVES FLOAT,BALANCELEAVES FLOAT,LEAVETYPEID INT,GRADE INT,CARRYFORWARD NVARCHAR(200),AVAILABLELEAVES FLOAT,ShowInESS NVARCHAR(50),Gender nvarchar(100),GenderApplicable nvarchar(100),MaxLeaves FLOAT)

DECLARE @T1 TABLE(AssignedLeaves FLOAT,AvailableLeaves FLOAT,FromDate DATETIME,ToDate DATETIME,MaxEncashLeaves FLOAT,MaxLeaves FLOAT,ActualAvailableLeaves FLOAT,ThresholdLimit FLOAT)

SELECT @IsGradeWiseMP=CONVERT(BIT,Value) FROM ADM_GlobalPreferences WITH(NOLOCK) WHERE Name=''GradeWiseMonthlyPayroll''
SET @ASONDATE=GETDATE()

SELECT GradeID,CONVERT(DATETIME,PayrollDate) PayrollDate,Type,ComponentID,CarryForward,AvailInProbation,ISNULL(ShowInESS,''Yes'') ShowInESS,GenderBasedOn,isnull(MaxLeaves,0) MaxLeaves  INTO #T1 FROM COM_CC50054 WITH(NOLOCK) WHERE TYPE=4

Select TOP 1 @VacationName=c.Name,@vCompID=CONVERT(BIGINT,dcAlpha1)
FROM INV_DocDetails a WITH(NOLOCK)
JOIN COM_DocTextData b WITH(NOLOCK) on b.InvDocDetailsID=a.InvDocDetailsID
join com_cc50052 c with(nolock) on c.NodeID=CONVERT(BIGINT,dcAlpha1) 
WHERE b.tCostCenterID=40061

INSERT INTO @TAB
SELECT B.NODEID NODEID,B.CODE AS EMPCODE,B.NAME AS EMPNAME,C.NAME AS LEAVETYPE,A.LEAVEYEAR,SUM(A.OPENINGBALANCE) OPENINGBALANCE,SUM(A.ASSIGNEDLEAVES) ASSIGNEDLEAVES,SUM(A.DEDUCTEDLEAVES) DEDUCTEDLEAVES,  CASE CONVERT(FLOAT,SUM(A.OPENINGBALANCE))+CONVERT(FLOAT,SUM(A.ASSIGNEDLEAVES)) WHEN 0 THEN 0 ELSE SUM(A.BALANCELEAVES)  END AS BALANCELEAVES,A.LEAVETYPEID LEAVETYPEID,MAX(CC.CCNID53) Grade,'''',0,'''',max(b.Gender),''YES'',0
FROM PAY_EMPLOYEELEAVEDETAILS A WITH(NOLOCK)  
JOIN COM_CC50051 B WITH(NOLOCK) ON B.NODEID=A.EMPLOYEEID  
JOIN COM_CC50052 C WITH(NOLOCK) ON C.NODEID=A.LEAVETYPEID 
JOIN COM_CCCCData CC WITH(NOLOCK) ON CC.NodeID=B.NodeID AND CC.CostCenterID=50051
WHERE 1=1    @LEAVEYEAR@    
@EMPWHERE@
GROUP BY   B.NODEID,B.CODE,B.NAME,C.NAME,A.LEAVEYEAR,A.LEAVETYPEID

SET @I=1
SELECT @CNT=COUNT(*) FROM @TAB

WHILE(@I<=@CNT)
BEGIN
SELECT @GRADE=GRADE,@LeaveType=LEAVETYPEID,@EMPNODE=NODEID,@Gender=Gender FROM @TAB WHERE ID=@I

SET @CARRYFORWARD=''''
set @GenderApplicable=''NO''

SELECT @GenderBasedOn=GenderBasedOn FROM #T1 WITH(NOLOCK) WHERE GRADEID=@Grade AND COMPONENTID=@LeaveType	AND PAYROLLDATE=(SELECT MAX(PAYROLLDATE) FROM #T1  WITH(NOLOCK) WHERE CONVERT(DATETIME,PAYROLLDATE)<=@ASONDATE AND GradeID=1)

if(isnull(@GenderBasedOn,'''')='''' OR @GenderBasedOn like''%,''+@Gender+'',%'')
begin
set @GenderApplicable=''YES''
end

	IF @IsGradeWiseMP=1
	BEGIN
		SELECT @CARRYFORWARD=ISNULL(CarryForward,''''),@AvailInProbation=ISNULL(AvailInProbation,''Yes''),@ShowInESS=ShowInESS,@MaxLeaves=MaxLeaves FROM #T1 WITH(NOLOCK) WHERE GRADEID=@Grade AND COMPONENTID=@LeaveType	AND PAYROLLDATE=(SELECT MAX(PAYROLLDATE) FROM #T1  WITH(NOLOCK) WHERE CONVERT(DATETIME,PAYROLLDATE)<=@ASONDATE AND GradeID=@Grade)

		if(isnull(@vCompID,0)>0)
		begin
			SELECT @ShowVacation=ShowInESS FROM #T1 WITH(NOLOCK) WHERE GRADEID=@Grade AND COMPONENTID=@vCompID	AND PAYROLLDATE=(SELECT MAX(PAYROLLDATE) FROM #T1  WITH(NOLOCK) WHERE CONVERT(DATETIME,PAYROLLDATE)<=@ASONDATE AND GradeID=@Grade)
		end
	END
	ELSE
	BEGIN
		SELECT @CARRYFORWARD=ISNULL(CarryForward,''''),@AvailInProbation=ISNULL(AvailInProbation,''Yes''),@ShowInESS=ShowInESS,@MaxLeaves=MaxLeaves FROM #T1 WITH(NOLOCK) WHERE GRADEID=1 AND COMPONENTID=@LeaveType	AND PAYROLLDATE=(SELECT MAX(PAYROLLDATE) FROM #T1  WITH(NOLOCK) WHERE CONVERT(DATETIME,PAYROLLDATE)<=@ASONDATE AND GradeID=1)

		if(isnull(@vCompID,0)>0)
		begin
			SELECT @ShowVacation=ShowInESS FROM #T1 WITH(NOLOCK) WHERE GRADEID=@Grade AND COMPONENTID=@vCompID	AND PAYROLLDATE=(SELECT MAX(PAYROLLDATE) FROM #T1  WITH(NOLOCK) WHERE CONVERT(DATETIME,PAYROLLDATE)<=@ASONDATE AND GradeID=1)
		end
	END

	IF (ISNULL(@CARRYFORWARD,'''')=''Monthly'' OR ISNULL(@CARRYFORWARD,'''')=''MonthlyYearly''  OR @AvailInProbation=''No'')
	BEGIN
		INSERT INTO @T1
		EXEC spPAY_ExtGetAssignedLeaves @EMPNODE,@LeaveType,@ASONDATE,0,1,1

		IF EXISTS(SELECT * FROM @T1)
		UPDATE @TAB SET CARRYFORWARD=@CARRYFORWARD,AVAILABLELEAVES=(SELECT AvailableLeaves FROM @T1),ShowInESS=UPPER(@ShowInESS),GenderApplicable=UPPER(@GenderApplicable),MaxLeaves=@MaxLeaves WHERE ID=@I
	END
	ELSE 
	BEGIN
		UPDATE @TAB SET CARRYFORWARD=@CARRYFORWARD,AVAILABLELEAVES=BALANCELEAVES,ShowInESS=UPPER(@ShowInESS),GenderApplicable=UPPER(@GenderApplicable),MaxLeaves=@MaxLeaves WHERE ID=@I
	END

	DELETE FROM @T1
	SET @I=@I+1
END

SELECT CODE EMPCODE,NAME EMPNAME,LEAVETYPE,LEAVEYEAR,SUM(OPENINGBALANCE) OPENINGBALANCE,ROUND(SUM(ASSIGNEDLEAVES),2) ASSIGNEDLEAVES,SUM(DEDUCTEDLEAVES) DEDUCTEDLEAVES,ROUND(SUM(BALANCELEAVES),2) BALANCELEAVES,LEAVETYPEID,ROUND(SUM(AVAILABLELEAVES),2) AVAILABLELEAVES,SHOWINESS,@ShowVacation ShowVacation,@VacationName VacationName,max(GenderApplicable) GenderApplicable,MAX(MaxLeaves) MaxLeaves FROM @TAB
GROUP BY CODE,NAME,LEAVETYPE,LEAVEYEAR,LEAVETYPEID,SHOWINESS
ORDER BY LEAVETYPEID
--SELECT * FROM @TAB
DROP TABLE #T1
' where reportid=310