--Sajid
DECLARE @Rid INT
SELECT @Rid=MAX(ResourceID) from COM_LanguageResources WITH(NOLOCK)
SET @Rid=@Rid+1

IF NOT EXISTS(SELECT Name FROM [ADM_GlobalPreferences] WITH(NOLOCK) WHERE  Name='FromDateAsClearanceDateForBRSClearance')
BEGIN
	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@Rid,'FromDateAsClearanceDateForBRSClearance',1,'English','Select FromDate As ClearanceDate For BRS Clearance','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',convert(float,getdate()),NULL,NULL,'')

	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@RId,'FromDateAsClearanceDateForBRS',2,'Arabic',N'Select FromDate As Clearance Date For BRS Clearance-AR','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',convert(float,getdate()),NULL,NULL,'')

	INSERT [dbo].[ADM_GlobalPreferences] ( [ResourceID], [Name], [Value], [DefaultValue], [GUID], [Description], [CreatedBy], [CreatedDate], [ModifiedBy], [ModifiedDate], [PreferenceTypeName], [PrefRowOrder], [PrefColOrder], [PrefValueType], [Version]) 
	VALUES ( @RId, N'FromDateAsClearanceDateForBRSClearance', N'False', N'False', N'guid', NULL, N'admin', convert(float,getdate()), NULL, NULL, NULL, NULL, NULL, NULL, NULL) 
END
