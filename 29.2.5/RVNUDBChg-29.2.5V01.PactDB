--Wajid

Declare @i int =1
 
Declare @SysTableName	nvarchar(100), @SysColumnName nvarchar(50), @SQL nvarchar(max)
 
set @SysTableName ='ADM_CompanyExtended'
 
While @i <=50
 
Begin 
	
	Set @SysColumnName = 'acAlpha' + CAST(@i as nvarchar(10))
	
	set @SQL = N'UPDATE Adm_CostCenterDef Set SysTableName = @TableName Where CostCenterID = 4 And SysColumnName = @ColumnName'

	
	exec sp_executesql @SQL, N'@TableName nvarchar(100), @ColumnName nvarchar(50)',@TableName = @SysTableName, @ColumnName = @SysColumnName
	
	Set @i = @i + 1
End
