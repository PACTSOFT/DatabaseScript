GO
/****** Object:  StoredProcedure [dbo].[spDOC_GetUBLDetails]    Script Date: 11-11-2026 09:06:40 ******/
IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[spDOC_GetUBLDetails]') AND type in (N'P', N'PC'))
DROP PROCEDURE [dbo].[spDOC_GetUBLDetails]
GO
/****** Object:  StoredProcedure [dbo].[spDOC_GetUAEUBLDetails]    Script Date: 11-11-2026 09:06:40 ******/
IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[spDOC_GetUAEUBLDetails]') AND type in (N'P', N'PC'))
DROP PROCEDURE [dbo].[spDOC_GetUAEUBLDetails]
GO
/****** Object:  StoredProcedure [dbo].[spDOC_GetUAEUBLDetails]    Script Date: 11-11-2026 09:06:40 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[spDOC_GetUAEUBLDetails]') AND type in (N'P', N'PC'))
BEGIN
EXEC dbo.sp_executesql @statement = N'
----[spDOC_GetUAEUBLDetails] 58122,40011,''UAEUBL'',12,1,1
--SELECT * FROM INV_DOCDETAILS WHERE VOUCHERNO =''TI-BHR-24/1924''

CREATE  PROCEDURE [dbo].[spDOC_GetUAEUBLDetails]
	@DocID [INT],
	@CostCenterID [int] = 0,
	@GSTType [nvarchar](16) = '''',
	@CompanyID [int] = 0,
	@UserID [int] = 1,
	@LangID [int] = 1
AS
BEGIN TRANSACTION    
BEGIN TRY     
SET NOCOUNT ON  

		CREATE TABLE #GSTMapping (ID INT IDENTITY(1,1) PRIMARY KEY,SysColumnName NVARCHAR(32),GSTColumnName NVARCHAR(32),SysTableName NVARCHAR(32),IsCalc BIT,DataType NVARCHAR(32),ValueType NVARCHAR(16),Reference INT,DefColumnName NVARCHAR(MAX))
		
		CREATE TABLE #MultiField (ID INT IDENTITY(1,1) PRIMARY KEY,DefColumnName NVARCHAR(MAX))
		CREATE TABLE #MultiFieldReason (ID INT IDENTITY(1,1) PRIMARY KEY,DefColumnName NVARCHAR(MAX))
		
		DECLARE @I INT,@ICNT INT,@J INT,@JCNT INT,@SysColumnName NVARCHAR(32),@GSTColumnName NVARCHAR(32),@IsCalc BIT,@SysTableName NVARCHAR(32),@DataType NVARCHAR(32),@ValueType NVARCHAR(16)
		,@TransTabColumns NVARCHAR(MAX),@TransColumns NVARCHAR(MAX),@Columns NVARCHAR(MAX),@JOIN NVARCHAR(MAX),@Reference INT,@SQL NVARCHAR(MAX),@DefColumnName NVARCHAR(MAX),@CurrencyType INT=0

		IF EXISTS(SELECT 1 FROM SYS.COLUMNS WHERE OBJECT_ID=OBJECT_ID(''COM_DocNumData'') AND NAME LIKE ''dcCalcNumFC%'') AND 
		((SELECT COUNT(*) FROM SYS.COLUMNS WHERE OBJECT_ID=OBJECT_ID(''COM_DocNumData'') AND NAME LIKE ''dcCalcNumFC%'')=(SELECT COUNT(*) FROM SYS.COLUMNS WHERE OBJECT_ID=OBJECT_ID(''COM_DocNumData'') AND NAME LIKE ''dcNum%''))
			SET @CurrencyType=1

		DECLARE @CCData TABLE (ID INT IDENTITY(1,1) PRIMARY KEY,Reference INT,NodeID INT)
		
		CREATE TABLE #AddDeatils (ID INT IDENTITY(1,1) PRIMARY KEY,DocID INT,AddType INT
		,PartyName NVARCHAR(100)
		,AddressLine1 NVARCHAR(MAX)
		,AddressLine2 NVARCHAR(MAX)
		,AddressLine3 NVARCHAR(MAX)
		,City NVARCHAR(MAX)
		,State NVARCHAR(MAX)
		,PostCode NVARCHAR(MAX)
		,Country NVARCHAR(MAX)
		,ContactName NVARCHAR(MAX)
		,ContactNumber NVARCHAR(MAX)
		,ContactEmail NVARCHAR(MAX)
		,VATNumber NVARCHAR(MAX)
		,RegistrationName NVARCHAR(MAX)
		,ElectronicAddress NVARCHAR(MAX)
		,Identification NVARCHAR(MAX)
		,IdentifierScheme NVARCHAR(MAX)
		,RegIdentification NVARCHAR(MAX)
		,RegIdentificationScheme NVARCHAR(MAX)
		,RegistrationAgency NVARCHAR(MAX)
		,RegistrationType NVARCHAR(MAX)
		,UserName NVARCHAR(32)
		,Password NVARCHAR(100))
		INSERT INTO #AddDeatils(DocID,AddType)
		SELECT @DocID,1
		UNION
		SELECT @DocID,2
		UNION
		SELECT @DocID,3
		UNION
		SELECT @DocID,4

		TRUNCATE TABLE #GSTMapping
		INSERT INTO #GSTMapping
		SELECT DISTINCT GM.SysColumnName,GM.GSTColumnName,isnull(CD.SysTableName,''Com_Address'')
		,GM.IsCalc,CD.ColumnDataType,GM.ValueType,GM.Reference,F.TableName
		FROM INV_GSTMapping GM WITH(NOLOCK)
		LEFT JOIN ADM_CostCenterDef CD WITH(NOLOCK) ON CD.CostCenterID=(CASE WHEN GM.Reference IN (92,93,94) THEN 110 ELSE GM.Reference END) AND CD.SysColumnName=GM.SysColumnName
		LEFT JOIN ADM_Features F WITH(NOLOCK) ON F.FeatureID=(CASE WHEN GM.Reference IN (92,93,94) AND (CD.ColumnCostCenterID IS NULL OR CD.ColumnCostCenterID=0) THEN 110 ELSE CD.ColumnCostCenterID END)
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND GM.ValueType IN (''Seller'',''Buyer'') AND GM.Reference<>0
		--SELECT * FROM #GSTMapping
		SELECT @I=1,@ICNT=COUNT(*) FROM #GSTMapping WITH(NOLOCK)
		
		WHILE @I<=@ICNT
		BEGIN
			SELECT @SQL='''',@SysColumnName=SysColumnName,@GSTColumnName=GSTColumnName,@IsCalc=IsCalc,@SysTableName=SysTableName,@DataType=DataType,@ValueType=ValueType,@DefColumnName=DefColumnName,@Reference=Reference
			FROM #GSTMapping WITH(NOLOCK) WHERE ID=@I
			
			IF @Reference=4
			BEGIN
				SET @SQL=''SELECT ''+@SysColumnName+'' FROM PACT2C.dbo.''+@SysTableName+'' WITH(NOLOCK) WHERE CompanyID=''+CONVERT(NVARCHAR,@CompanyID)
				
				IF(@DataType=''LISTBOX'')
				BEGIN
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
			END
			ELSE IF @Reference=2
			BEGIN
				IF NOT EXISTS (SELECT 1 FROM @CCData WHERE Reference=@Reference)
				BEGIN
					INSERT INTO @CCData
					SELECT @Reference,(CASE WHEN MAX(IDD.VoucherType)=-1 THEN MAX(IDD.DebitAccount) ELSE MAX(IDD.CreditAccount) END) 
					FROM INV_DocDetails IDD WITH(NOLOCK)
					WHERE IDD.DocID=@DocID
				END 

				
				IF(@SysTableName=''COM_Address'')
				BEGIN
					SET @SQL=''SELECT TOP 1 ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE FEATUREID=''+CONVERT(NVARCHAR,@Reference)+'' AND FEATUREPK=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
				END
				ELSE IF(@SysColumnName LIKE ''CCNID%'')
				BEGIN
					SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE CostCenterID=''+CONVERT(NVARCHAR,@Reference)+'' AND NodeID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
				ELSE
					SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE AccountID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference)) 
			END
			ELSE IF @Reference IN (92,93,94)
			BEGIN
				IF NOT EXISTS (SELECT 1 FROM @CCData WHERE Reference=@Reference)
				BEGIN
					INSERT INTO @CCData
					SELECT @Reference,ISNULL((SELECT AddressID FROM COM_DocAddressData WITH(NOLOCK) 
					WHERE DocID=@DocID AND [AddressTypeID]=(CASE WHEN @Reference=92 THEN 1 WHEN @Reference=93 THEN 2 ELSE 3 END )),0)
				END
				
				SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE AddressID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
				IF(@SysColumnName LIKE ''CCNID%'')
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
			END
			ELSE IF @Reference BETWEEN 40001 AND 49999
			BEGIN
				IF(@SysColumnName LIKE ''dcCCNID%'')
				BEGIN
					SET @SQL=''SELECT MAX(ISNULL(DCD.''+@SysColumnName+'','''''''')) FROM INV_DocDetails IDD WITH(NOLOCK)
					JOIN COM_DocCCData DCD WITH(NOLOCK) ON DCD.InvDocDetailsID=IDD.InvDocDetailsID
					WHERE IDD.DocID=''+CONVERT(NVARCHAR,@DocID)
					
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
				ELSE IF(@SysColumnName LIKE ''dcAlpha%'')
				BEGIN
					SET @SQL=''SELECT MAX(ISNULL(DTD.''+@SysColumnName+'','''''''')) FROM INV_DocDetails IDD WITH(NOLOCK)
					JOIN COM_DocTextData DTD WITH(NOLOCK) ON DTD.InvDocDetailsID=IDD.InvDocDetailsID
					WHERE IDD.DocID=''+CONVERT(NVARCHAR,@DocID)
					
					IF(@DefColumnName IS NOT NULL OR @DefColumnName<>'''')
						SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
			END
			ELSE IF @Reference>50000
			BEGIN
				IF NOT EXISTS (SELECT 1 FROM @CCData WHERE Reference=@Reference)
				BEGIN
					SET @SQL=''DECLARE @DocID INT=''+CONVERT(NVARCHAR,@DocID)+''
					SELECT ''+CONVERT(NVARCHAR,@Reference)+'',MAX(DCD.dcCCNID''+CONVERT(NVARCHAR,(@Reference-50000))+'') 
					FROM INV_DocDetails IDD WITH(NOLOCK)
					JOIN COM_DocCCData DCD WITH(NOLOCK) ON DCD.InvDocDetailsID=IDD.InvDocDetailsID
					WHERE IDD.DocID=@DocID''
					
					INSERT INTO @CCData
					EXEC (@SQL)
				END
				
				IF(@SysTableName=''COM_Address'')
				BEGIN
					SET @SQL=''SELECT TOP 1 ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE FEATUREID=''+CONVERT(NVARCHAR,@Reference)+'' AND FEATUREPK=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
				END
				ELSE
				BEGIN
					SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE NodeID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference)) 
					IF(@SysColumnName LIKE ''CCNID%'')
					BEGIN
						SET @SQL=@SQL+'' AND CostCenterID=''+CONVERT(NVARCHAR,@Reference)
						SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
					END
				END
			END
			
			SET @SQL=''UPDATE #AddDeatils SET ''+REPLACE(REPLACE(REPLACE(REPLACE(@GSTColumnName,''_Seller'',''''),''_Representative'',''''),''_Buyer'',''''),''_Delivery'','''')+''=(''+@SQL+'')
			WHERE AddType''

			IF(@GSTColumnName LIKE ''%_Seller'')
				SET @SQL=@SQL+''=1''
			ELSE IF(@GSTColumnName LIKE ''%_Representative'')
				SET @SQL=@SQL+''=2''
			ELSE IF(@GSTColumnName LIKE ''%_Buyer'')
				SET @SQL=@SQL+''=3''
			ELSE IF(@GSTColumnName LIKE ''%_Delivery'')
				SET @SQL=@SQL+''=4''
			ELSE
				SET @SQL=@SQL+'' IN (1,2,3,4)''	
			
			PRINT @SQL
			EXEC (@SQL)
			SET @I=@I+1
		END
		
		TRUNCATE TABLE #GSTMapping
		INSERT INTO #GSTMapping
		SELECT DISTINCT GM.SysColumnName,GM.GSTColumnName,F.TableName,GM.IsCalc,CD.ColumnDataType,GM.ValueType,GM.Reference,GM.DefColumnName
		FROM INV_GSTMapping GM WITH(NOLOCK)
		JOIN ADM_CostCenterDef CD WITH(NOLOCK) ON CD.CostCenterID=GM.CostCenterID AND CD.SysColumnName=GM.SysColumnName
		LEFT JOIN ADM_Features F WITH(NOLOCK) ON F.FeatureID=CD.ColumnCostCenterID
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND ValueType NOT IN (''Seller'',''Buyer'')
		UNION 
		SELECT DISTINCT GM.SysColumnName,GM.GSTColumnName,NULL,GM.IsCalc,''FLOAT'',GM.ValueType,GM.Reference,GM.DefColumnName
		FROM INV_GSTMapping GM WITH(NOLOCK)
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND ValueType NOT IN (''Seller'',''Buyer'') AND (GM.SysColumnName=''MULTIPLEFIELDS'' OR GM.SysColumnName=''MULTIPLEFIELDS_Reason''OR GM.SysColumnName=''MULTIPLEFIELDS_Dimension'')

		IF NOT EXISTS (SELECT 1 FROM #GSTMapping WITH(NOLOCK) WHERE GSTColumnName=''InvIssueTime'')
		BEGIN
			INSERT INTO #GSTMapping
			SELECT DISTINCT GM.DefColumnName,GM.GSTColumnName,NULL,GM.IsCalc,''DATE'',GM.ValueType,GM.Reference,GM.DefColumnName 
			FROM INV_GSTMapping GM WITH(NOLOCK)
			WHERE GM.CostCenterID=0 AND GM.GSTType=@GSTType AND GSTColumnName=''InvIssueTime''
		END
		SELECT @I=1,@ICNT=COUNT(*),@TransTabColumns='''',@TransColumns='''',@Columns='''',@JOIN='''' FROM #GSTMapping WITH(NOLOCK)
		--SELECT * FROM #GSTMapping WITH(NOLOCK)
		WHILE @I<=@ICNT
		BEGIN
		
			SELECT @SysColumnName=SysColumnName,@GSTColumnName=GSTColumnName,@IsCalc=IsCalc,@SysTableName=SysTableName,@DataType=DataType,@ValueType=ValueType,@DefColumnName=DefColumnName
			FROM #GSTMapping WITH(NOLOCK) WHERE ID=@I
			--SELECT @I,@Columns,@GSTColumnName
			
			IF(@SysColumnName=''MULTIPLEFIELDS'')
			BEGIN
				IF @DefColumnName IS NOT NULL AND @DefColumnName<>''''
				BEGIN
					IF(@ValueType=''Transaction'')
					BEGIN
						SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
						IF (@IsCalc=1)
						BEGIN
							IF(@CurrencyType=1)
								SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNumFC'')+'',0)) ''+@GSTColumnName
							ELSE
								SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNum'')+'',0)) ''+@GSTColumnName
						END
						ELSE
							SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.'')+'',0)) ''+@GSTColumnName
					END
					ELSE
					BEGIN
						IF (@IsCalc=1)
						BEGIN
							IF(@CurrencyType=1)
								SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNumFC'')+'',0) ''+@GSTColumnName
							ELSE
								SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNum'')+'',0) ''+@GSTColumnName
						END
						ELSE
							SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.'')+'',0) ''+@GSTColumnName
					END
				END
			END
			ELSE IF(@SysColumnName=''MULTIPLEFIELDS_Reason'' OR @SysColumnName=''MULTIPLEFIELDS_Dimension'')
			BEGIN
				IF @DefColumnName IS NOT NULL AND @DefColumnName<>''''
				BEGIN
					
					TRUNCATE TABLE #MultiField
					INSERT INTO #MultiField
					EXEC SPSplitString @DefColumnName,'','' 
					
					SELECT @J=1,@JCNT=COUNT(*) FROM #MultiField WITH(NOLOCK)
					WHILE @J<=@JCNT
					BEGIN
					
						SELECT @DefColumnName=DefColumnName FROM #MultiField WITH(NOLOCK) WHERE ID=@J
					
						TRUNCATE TABLE #MultiFieldReason

						IF(@SysColumnName=''MULTIPLEFIELDS_Dimension'')
							INSERT INTO #MultiFieldReason
							EXEC SPSplitString @DefColumnName,''`''
						ELSE
							INSERT INTO #MultiFieldReason
							EXEC SPSplitString @DefColumnName,''~''
						
						
						IF(@ValueType=''Transaction'')
						BEGIN
							SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
							IF (@IsCalc=1)
							BEGIN
								IF(@CurrencyType=1)
									SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNumFC'')+'',0)) ''+@GSTColumnName
								ELSE
									SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNum'')+'',0)) ''+@GSTColumnName
							END
							ELSE
								SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.'')+'',0)) ''+@GSTColumnName
						END
						ELSE
						BEGIN
							IF (@IsCalc=1)
							BEGIN
								IF(@CurrencyType=1)
									SELECT @Columns=@Columns+'',ISNULL(ISNULL(DND.''+REPLACE(DefColumnName,''dcNum'',''dcCalcNumFC'')+'',DND.''+REPLACE(DefColumnName,''dcNum'',''dcCalcNum'')+''),0) ''
									FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=1
								ELSE
									SELECT @Columns=@Columns+'',ISNULL(DND.''+REPLACE(DefColumnName,''dcNum'',''dcCalcNum'')+'',0) ''
									FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=1
							END
							ELSE
								SELECT @Columns=@Columns+'',ISNULL(DND.''+DefColumnName+'',0) '' 
								FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=1
							SELECT @Columns=@Columns+@GSTColumnName+''_''+CONVERT(NVARCHAR,@J)
							
							IF(@SysColumnName=''MULTIPLEFIELDS_Dimension'')
							BEGIN
								SELECT @Columns=@Columns+'',''''''+DefColumnName+'''''' ''+@GSTColumnName+''_Code_''+CONVERT(NVARCHAR,@J) 
								FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=3
								SELECT @Columns=@Columns+'',''''''+DefColumnName+'''''' ''+@GSTColumnName+''_Reason_''+CONVERT(NVARCHAR,@J) 
								FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=2
							END
							ELSE
							BEGIN
								SELECT @Columns=@Columns+'',''''''+DefColumnName+'''''' ''+@GSTColumnName+''_Code_''+CONVERT(NVARCHAR,@J) 
								FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=2
								SELECT @Columns=@Columns+'',''''''+DefColumnName+'''''' ''+@GSTColumnName+''_Reason_''+CONVERT(NVARCHAR,@J) 
								FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=3
							END	
						END
					
						SET @J=@J+1
					END 
				END
			END
			ELSE IF(@SysColumnName LIKE ''dcNum%'')
			BEGIN
				IF(@ValueType=''Transaction'')
				BEGIN
					SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
					IF (@IsCalc=1)
					BEGIN
						IF(@CurrencyType=1)
							SET @TransColumns=@TransColumns+'',SUM(ISNULL(ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNumFC'')+'',DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+''),0)) ''+@GSTColumnName
						ELSE
							SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+'',0)) ''+@GSTColumnName
					END
					ELSE
						SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+@SysColumnName+'',0)) ''+@GSTColumnName
				END
				ELSE
				BEGIN
					IF (@IsCalc=1)
					BEGIN
						IF(@CurrencyType=1)
							SET @Columns=@Columns+'',ISNULL(ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNumFC'')+'',DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+''),0) ''+@GSTColumnName
						ELSE
							SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+'',0) ''+@GSTColumnName
					END
					ELSE
						SET @Columns=@Columns+'',ISNULL(DND.''+@SysColumnName+'',0) ''+@GSTColumnName
				END
			END
			ELSE IF(@SysColumnName LIKE ''dcCCNID%'' AND @SysTableName IS NOT NULL AND @SysTableName<>'''')
			BEGIN
				IF @GSTColumnName=''InvoiceType''
					SET @Columns=@Columns+'',CASE WHEN DCD.''+@SysColumnName+''>1 THEN CC''+CONVERT(NVARCHAR,@I)+ (CASE WHEN @IsCalc=1 THEN ''.Name '' ELSE ''.Code '' END)+'' WHEN (''+@DefColumnName+''=0 AND EXISTS (SELECT 1 FROM #REFTAB WITH(NOLOCK) WHERE InvoiceType>1)) THEN (SELECT TOP 1 CONVERT(NVARCHAR,InvoiceType) FROM #REFTAB WITH(NOLOCK) WHERE InvoiceType>1) ELSE ''''''+@DefColumnName+'''''' END ''+@GSTColumnName
				ELSE 
					SET @Columns=@Columns+'',CC''+CONVERT(NVARCHAR,@I)+ (CASE WHEN @IsCalc=1 THEN ''.Name '' ELSE ''.Code '' END)+@GSTColumnName
				
				SET @JOIN=@JOIN+'' JOIN ''+@SysTableName+'' CC''+CONVERT(NVARCHAR,@I)+'' WITH(NOLOCK) ON CC''+CONVERT(NVARCHAR,@I)+''.NodeID=DCD.''+@SysColumnName
			END
			ELSE IF(@SysColumnName LIKE ''dcAlpha%'')
			BEGIN
				IF(@SysTableName IS NULL OR @SysTableName='''')
					SET @Columns=@Columns+'',DTD.''+@SysColumnName+'' ''+@GSTColumnName
				ELSE
				BEGIN
					SET @Columns=@Columns+'',CC''+CONVERT(NVARCHAR,@I)+ (CASE WHEN @IsCalc=1 THEN ''.Name '' ELSE ''.Code '' END) + @GSTColumnName
					SET @JOIN=@JOIN+'' LEFT JOIN ''+@SysTableName+'' CC''+CONVERT(NVARCHAR,@I)+'' WITH(NOLOCK) ON CONVERT(NVARCHAR,CC''+CONVERT(NVARCHAR,@I)+''.NodeID)=DTD.''+@SysColumnName
				END
			END
			ELSE 
			BEGIN
				IF (@DataType LIKE ''DATE%'')
					SET @Columns=@Columns+'',CONVERT(DATETIME,IDD.''+@SysColumnName+'') ''+@GSTColumnName
				ELSE IF(@SysColumnName=''ProductID'')
				BEGIN
					SET @Columns=@Columns+ '',PR.Product''+ (CASE WHEN @IsCalc=1 THEN ''Name '' ELSE ''Code '' END) +@GSTColumnName
				END
				ELSE IF(@SysColumnName=''Net'' AND @ValueType=''Transaction'')
				BEGIN
					SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
					SET @TransColumns=@TransColumns+'',SUM(ISNULL(IDD.''+@SysColumnName+'',0)) ''+@GSTColumnName
				END
				ELSE IF(@GSTColumnName=''Rate'')
					SET @Columns=@Columns+'',IDD.''+@SysColumnName+'' ''+@GSTColumnName
				ELSE IF(@GSTColumnName=''Gross'')
				BEGIN
					IF(@CurrencyType=1)
						SET @Columns=@Columns+'',IDD.''+@SysColumnName+''FC ''+@GSTColumnName
					ELSE
						SET @Columns=@Columns+'',IDD.''+@SysColumnName+'' ''+@GSTColumnName
				END
				ELSE IF(@GSTColumnName=''Unit'')
				begin
					SET @JOIN=@JOIN+'' JOIN COM_UOM UM WITH(NOLOCK) ON UM.UOMID=IDD.''+@SysColumnName

					IF EXISTS (SELECT 1 FROM SYS.tables WHERE name=''COM_CC50093'') AND EXISTS(SELECT 1 FROM SYS.COLUMNS WHERE OBJECT_ID=OBJECT_ID(''COM_UOM'') AND NAME = ''DimKey'')
					BEGIN
						SET @Columns=@Columns+'',ISNULL(UMD.Code,UM.UnitName) ''+@GSTColumnName
						SET @JOIN=@JOIN+'' LEFT JOIN COM_CC50093 UMD WITH(NOLOCK) ON UMD.NodeID=UM.DimKey''
					END
					ELSE
						SET @Columns=@Columns+'',UM.UnitName ''+@GSTColumnName
				END
				ELSE
					SET @Columns=@Columns+'',IDD.''+@SysColumnName+'' ''+@GSTColumnName
			END
			SET @I=@I+1
		END
		
		DECLARE @TEMPSQL NVARCHAR(MAX)='''',@PrefValue NVARCHAR(MAX)=''''
		CREATE TABLE #REFTAB (VoucherNo NVARCHAR(64),DocDate FLOAT,ParticularID INT,InvoiceType INT)
		SET @SQL=''''
		SET @PrefValue=''''
		SET @TEMPSQL=''''
		SELECT @PrefValue=''dcCCNID''+CONVERT(NVARCHAR,CONVERT(INT,Value)-50000) FROM ADM_GlobalPreferences WITH(NOLOCK) 
		WHERE Name=''DepositLinkDimension'' AND ISNUMERIC(Value)=1

		IF ISNULL(@PrefValue,'''')<>''''
		BEGIN
			SELECT @TEMPSQL=SysColumnName 
			FROM INV_GSTMapping WHERE GSTType=''UAEUBL'' AND CostCenterID=@CostCenterID AND GSTColumnName=''InvoiceType''

			SET @SQL=''DECLARE @ContractID INT,@DocID INT=''+CONVERT(NVARCHAR,@DocID)+''
			SELECT @ContractID=IDD.RefNodeID FROM [INV_DocDetails] IDD WITH(NOLOCK)
			WHERE IDD.DocID=@DocID AND IDD.DocumentType IN (6,10,39) AND IDD.RefCCID=95

			if (@ContractID is not null and @ContractID>0)
			begin
				DECLARE @SRCDoc INT
				SELECT @SRCDoc=CONVERT(INT,Value) FROM COM_CostCenterPreferences WITH(NOLOCK)
				WHERE CostCenterID=95 AND Name=''''ContractSalesInvoice'''' AND ISNUMERIC(Value)=1

				;WITH RenewalRoot AS (
				SELECT ContractID,RenewRefID--,1 AS Level
				FROM REN_Contract WITH(NOLOCK)
				WHERE ContractID=@ContractID
				UNION ALL
				SELECT RC.ContractID,RC.RenewRefID--,R.Level+1
				FROM REN_Contract RC WITH(NOLOCK)
				JOIN RenewalRoot R ON R.RenewRefID=RC.ContractID
				)
				SELECT ContractID INTO #REFID
				FROM RenewalRoot 

				INSERT INTO #REFTAB
				SELECT VoucherNo,DocDate,''+@PrefValue+'',''+@TEMPSQL+'' FROM (
				SELECT ROW_NUMBER() OVER (PARTITION BY DCD.dcCCNID16 ORDER BY LIDD.DocDate DESC) RNO,LIDD.VoucherNo,LIDD.DocDate,DCD.''+@PrefValue+'',LDCD.''+@TEMPSQL+''
				FROM [INV_DocDetails] IDD WITH(NOLOCK)
				JOIN COM_DocCCData DCD WITH(NOLOCK) ON DCD.[InvDocDetailsID]=IDD.[InvDocDetailsID]
				JOIN [INV_DocDetails] LIDD WITH(NOLOCK) ON LIDD.RefCCID=IDD.RefCCID AND LIDD.RefNodeID IN (SELECT ContractID FROM #REFID WITH(NOLOCK))
				JOIN COM_DocCCData LDCD WITH(NOLOCK) ON LDCD.[InvDocDetailsID]=LIDD.[InvDocDetailsID] AND LDCD.''+@PrefValue+''=DCD.''+@PrefValue+''
				WHERE IDD.DocID=@DocID AND LIDD.CostCenterID=@SRCDoc
				GROUP BY LIDD.VoucherNo,LIDD.DocDate,DCD.''+@PrefValue+'',LDCD.''+@TEMPSQL+''
				) AS T
				WHERE RNO=1
				
				UPDATE #REFTAB SET InvoiceType=381 WHERE InvoiceType=380
				UPDATE #REFTAB SET InvoiceType=81 WHERE InvoiceType=480
				UPDATE #REFTAB SET InvoiceType=261 WHERE InvoiceType=389

				DROP TABLE #REFID
			end''
			EXEC (@SQL)
		END

	
		SET @SQL=''''
		SET @TEMPSQL=''''
		SET @PrefValue=''''
		SELECT @PrefValue=Value FROM ADM_GlobalPreferences WITH(NOLOCK) WHERE Name=''UAEEINVMaintainOn''
		IF ISNULL(@PrefValue,'''')<>''''
		BEGIN
			IF @PrefValue=''4''
			BEGIN
				SET @PrefValue=''''
				SELECT @PrefValue=Value FROM  ADM_GlobalPreferences WITH(NOLOCK) WHERE Name=''UAEEINVwef'' AND Value<>''''

				IF ISNULL(@PrefValue,'''')<>''''
					SET @PrefValue=''''''''+CONVERT(NVARCHAR(MAX),CONVERT(DATETIME,@PrefValue))+''''''''
			END
			ELSE
			BEGIN
				SET @TEMPSQL=''DECLARE @XML XML 
				SELECT @XML=Value FROM  ADM_GlobalPreferences WITH(NOLOCK) WHERE Name=''''UAEEINVwef'''' AND Value<>''''''''''
				
				SET @PrefValue=''DCD.dcCCNID''+CONVERT(NVARCHAR,CONVERT(INT,@PrefValue)-50000)
				SET @PrefValue=''(SELECT TOP 1 X.value(''''@wef'''',''''datetime'''')    
				FROM @XML.nodes(''''/XML/L'''') as Data(X) where X.value(''''@ID'''',''''INT'''') =''+@PrefValue+'')''  
			END

			IF ISNULL(@PrefValue,'''')<>''''
				SET @SQL=@SQL+'',''+@PrefValue+'' WEF''
		END

		SET @SQL=''DECLARE @DocID INT=''+CONVERT(NVARCHAR,@DocID)+''
		''+@TEMPSQL+''
		SELECT IDD.DocID,IDD.DocSeqNo''+@SQL+''
		,IDD.DocNumber
		,DID.[GUID]
		,IDD.ExchangeRate
		,CU.Code CurrencyCode
		,''''AED'''' TaxCurrencyCode''

		SET @SQL=@SQL+'',SA.UserName,SA.Password,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.PartyName ELSE BA.PartyName END) PartyName_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.AddressLine1 ELSE BA.AddressLine1 END) AddressLine1_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.AddressLine2 ELSE BA.AddressLine2 END) AddressLine2_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.AddressLine3 ELSE BA.AddressLine3 END) AddressLine3_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.City ELSE BA.City END) City_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.State ELSE BA.State END) State_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.PostCode ELSE BA.PostCode END) PostCode_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.Country ELSE BA.Country END) Country_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.ContactName ELSE BA.ContactName END) ContactName_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.ContactNumber ELSE BA.ContactNumber END) ContactNumber_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.ContactEmail ELSE BA.ContactEmail END) ContactEmail_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.VATNumber ELSE BA.VATNumber END) VATNumber_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.RegistrationName ELSE BA.RegistrationName END) RegistrationName_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.ElectronicAddress ELSE BA.ElectronicAddress END) ElectronicAddress_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.Identification ELSE BA.Identification END) Identification_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.IdentifierScheme ELSE BA.IdentifierScheme END) IdentifierScheme_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.RegIdentification ELSE BA.RegIdentification END) RegIdentification_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.RegIdentificationScheme ELSE BA.RegIdentificationScheme END) RegIdentificationScheme_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.RegistrationType ELSE BA.RegistrationType END) RegistrationType_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.RegistrationAgency ELSE BA.RegistrationAgency END) RegistrationAgency_Seller''

		SET @SQL=@SQL+'',(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.PartyName ELSE DA.PartyName END) PartyName_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.AddressLine1 ELSE DA.AddressLine1 END) AddressLine1_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.AddressLine2 ELSE DA.AddressLine2 END) AddressLine2_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.AddressLine3 ELSE DA.AddressLine3 END) AddressLine3_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.City ELSE DA.City END) City_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.State ELSE DA.State END) State_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.PostCode ELSE DA.PostCode END) PostCode_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.Country ELSE DA.Country END) Country_Representative
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN RA.VATNumber ELSE DA.VATNumber END) VATNumber_Representative
''
		SET @SQL=@SQL+'',(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.PartyName ELSE SA.PartyName END) PartyName_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.AddressLine1 ELSE SA.AddressLine1 END) AddressLine1_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.AddressLine2 ELSE SA.AddressLine2 END) AddressLine2_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.AddressLine3 ELSE SA.AddressLine3 END) AddressLine3_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.City ELSE SA.City END) City_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.State ELSE SA.State END) State_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.PostCode ELSE SA.PostCode END) PostCode_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.Country ELSE SA.Country END) Country_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.ContactName ELSE SA.ContactName END) ContactName_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.ContactNumber ELSE SA.ContactNumber END) ContactNumber_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.ContactEmail ELSE SA.ContactEmail END) ContactEmail_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.VATNumber ELSE SA.VATNumber END) VATNumber_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.RegistrationName ELSE SA.RegistrationName END) RegistrationName_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.ElectronicAddress ELSE SA.ElectronicAddress END) ElectronicAddress_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.Identification ELSE SA.Identification END) Identification_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.IdentifierScheme ELSE SA.IdentifierScheme END) IdentifierScheme_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.RegIdentification ELSE SA.RegIdentification END) RegIdentification_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.RegIdentificationScheme ELSE SA.RegIdentificationScheme END) RegIdentificationScheme_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.RegistrationType ELSE SA.RegistrationType END) RegistrationType_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.RegistrationAgency ELSE SA.RegistrationAgency END) RegistrationAgency_Buyer
''
		SET @SQL=@SQL+'',(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.PartyName ELSE RA.PartyName END) PartyName_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.AddressLine1 ELSE RA.AddressLine1 END) AddressLine1_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.AddressLine2 ELSE RA.AddressLine2 END) AddressLine2_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.AddressLine3 ELSE RA.AddressLine3 END) AddressLine3_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.City ELSE RA.City END) City_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.State ELSE RA.State END) State_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.PostCode ELSE RA.PostCode END) PostCode_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.Country ELSE RA.Country END) Country_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.VATNumber ELSE RA.VATNumber END) VATNumber_Delivery
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN DA.ElectronicAddress ELSE RA.ElectronicAddress END) ElectronicAddress_Delivery
''
		SET @SQL=@SQL+@Columns
		SET @SQL=@SQL+'' FROM INV_DocDetails IDD WITH(NOLOCK)
			JOIN COM_DocID DID WITH(NOLOCK) ON DID.ID=IDD.DocID
			JOIN COM_Currency CU WITH(NOLOCK) ON CU.CurrencyID=IDD.CurrencyID
			JOIN COM_DocNumData DND WITH(NOLOCK) ON DND.InvDocDetailsID=IDD.InvDocDetailsID
			JOIN COM_DocCCData DCD WITH(NOLOCK) ON DCD.InvDocDetailsID=IDD.InvDocDetailsID
			JOIN COM_DocTextData DTD WITH(NOLOCK) ON DTD.InvDocDetailsID=IDD.InvDocDetailsID 
			JOIN INV_Product PR WITH(NOLOCK) ON PR.ProductID=IDD.ProductID 
			JOIN #AddDeatils SA WITH(NOLOCK) ON SA.DocID=IDD.DocID AND SA.AddType=1
			JOIN #AddDeatils RA WITH(NOLOCK) ON RA.DocID=IDD.DocID AND RA.AddType=2
			JOIN #AddDeatils BA WITH(NOLOCK) ON BA.DocID=IDD.DocID AND BA.AddType=3
			JOIN #AddDeatils DA WITH(NOLOCK) ON DA.DocID=IDD.DocID AND DA.AddType=4 ''
		SET @SQL=@SQL+@JOIN
		SET @SQL=@SQL+'' WHERE IDD.DocID=@DocID AND IDD.StatusID=369 AND IDD.Quantity>0 AND (IDD.IsQtyFreeOffer=0 OR IDD.ParentSchemeID IS NULL) AND IDD.DynamicInvDocDetailsID IS NULL''

		PRINT @SQL
		PRINT SUBSTRING(@SQL,4001,4000)
		PRINT SUBSTRING(@SQL,8001,4000)
		EXEC (@SQL)
		
		SET @IsCalc=0
		IF EXISTS (SELECT 1 FROM INV_GSTMapping GM WITH(NOLOCK)
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND ValueType=''Items'' AND GSTColumnName IN (''RefDocNo'',''RefDocDate'') AND IsCalc=1)
			SET @IsCalc=1
		
		SELECT DISTINCT LIDD.VoucherNo RefDocNo,CONVERT(DATETIME,LIDD.DocDate) RefDocDate,@IsCalc IsCalc
		FROM INV_DocDetails IDD WITH(NOLOCK)
		JOIN INV_DocDetails LIDD WITH(NOLOCK) ON IDD.LinkedInvDocDetailsID=LIDD.InvDocDetailsID
		WHERE IDD.DocID=@DocID AND IDD.LinkedInvDocDetailsID>0
		UNION ALL
		SELECT DISTINCT LIDD.VoucherNo collate database_default ,CONVERT(DATETIME,LIDD.DocDate) RefDocDate,@IsCalc IsCalc 
		FROM #REFTAB LIDD WITH(NOLOCK)

		DROP TABLE #REFTAB
		DROP TABLE #MultiField
		DROP TABLE #MultiFieldReason
		DROP TABLE #GSTMapping
		DROP TABLE #AddDeatils

COMMIT TRANSACTION    
SET NOCOUNT OFF;    
return 1
END TRY    
BEGIN CATCH      
 --Return exception info [Message,Number,ProcedureName,LineNumber]      
 IF ERROR_NUMBER()=50000    
 BEGIN    
  SELECT ErrorMessage,ErrorNumber FROM COM_ErrorMessages WITH(nolock) WHERE ErrorNumber=ERROR_MESSAGE() AND LanguageID=@LangID    
 END    
 ELSE    
 BEGIN    
  SELECT ErrorMessage, ERROR_MESSAGE() AS ServerMessage,ERROR_NUMBER() as ErrorNumber, ERROR_PROCEDURE()as ProcedureName, ERROR_LINE() AS ErrorLine    
  FROM COM_ErrorMessages WITH(nolock) WHERE ErrorNumber=-999 AND LanguageID=@LangID    
 END    
ROLLBACK TRANSACTION    
SET NOCOUNT OFF      
RETURN -999       
END CATCH     
		
--EXEC [spDOC_GetUAEUBLDetails] 76644,40006,''UAEUBL'',622,1,1








' 
END
GO
/****** Object:  StoredProcedure [dbo].[spDOC_GetUBLDetails]    Script Date: 11-11-2026 09:06:40 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[spDOC_GetUBLDetails]') AND type in (N'P', N'PC'))
BEGIN
EXEC dbo.sp_executesql @statement = N'
CREATE  PROCEDURE [dbo].[spDOC_GetUBLDetails]
	@DocID [INT],
	@CostCenterID [int] = 0,
	@GSTType [nvarchar](16) = '''',
	@CompanyID [int] = 0,
	@UserID [int] = 1,
	@LangID [int] = 1
AS
BEGIN TRANSACTION    
BEGIN TRY     
SET NOCOUNT ON  

		CREATE TABLE #GSTMapping (ID INT IDENTITY(1,1) PRIMARY KEY,SysColumnName NVARCHAR(32),GSTColumnName NVARCHAR(32),SysTableName NVARCHAR(32),IsCalc BIT,DataType NVARCHAR(32),ValueType NVARCHAR(16),Reference INT,DefColumnName NVARCHAR(MAX))
		
		CREATE TABLE #MultiField (ID INT IDENTITY(1,1) PRIMARY KEY,DefColumnName NVARCHAR(MAX))
		CREATE TABLE #MultiFieldReason (ID INT IDENTITY(1,1) PRIMARY KEY,DefColumnName NVARCHAR(MAX))
		
		DECLARE @I INT,@ICNT INT,@J INT,@JCNT INT,@SysColumnName NVARCHAR(32),@GSTColumnName NVARCHAR(32),@IsCalc BIT,@SysTableName NVARCHAR(32),@DataType NVARCHAR(32),@ValueType NVARCHAR(16)
		,@TransTabColumns NVARCHAR(MAX),@TransColumns NVARCHAR(MAX),@Columns NVARCHAR(MAX),@JOIN NVARCHAR(MAX),@Reference INT,@SQL NVARCHAR(MAX),@DefColumnName NVARCHAR(MAX),@CurrencyType INT=0

		IF EXISTS(SELECT 1 FROM SYS.COLUMNS WHERE OBJECT_ID=OBJECT_ID(''COM_DocNumData'') AND NAME LIKE ''dcCalcNumFC%'') AND 
		((SELECT COUNT(*) FROM SYS.COLUMNS WHERE OBJECT_ID=OBJECT_ID(''COM_DocNumData'') AND NAME LIKE ''dcCalcNumFC%'')=(SELECT COUNT(*) FROM SYS.COLUMNS WHERE OBJECT_ID=OBJECT_ID(''COM_DocNumData'') AND NAME LIKE ''dcNum%''))
			SET @CurrencyType=1

		DECLARE @CCData TABLE (ID INT IDENTITY(1,1) PRIMARY KEY,Reference INT,NodeID INT)
		
		CREATE TABLE #AddDeatils (ID INT IDENTITY(1,1) PRIMARY KEY,DocID INT,AddType INT,Identification NVARCHAR(32),SchemeID NVARCHAR(MAX),BuildingNumber NVARCHAR(100),PlotIdentification NVARCHAR(100),StreetName NVARCHAR(100),AdditionalStreetName NVARCHAR(MAX),CityName NVARCHAR(MAX),District NVARCHAR(MAX),PostalZone NVARCHAR(MAX),Country NVARCHAR(MAX),CountrySubentityCode NVARCHAR(MAX),VATNumber NVARCHAR(MAX),RegistrationName NVARCHAR(MAX))
		INSERT INTO #AddDeatils(DocID,AddType)
		SELECT @DocID,1
		UNION
		SELECT @DocID,2
		
		TRUNCATE TABLE #GSTMapping
		INSERT INTO #GSTMapping
		SELECT DISTINCT GM.SysColumnName,GM.GSTColumnName,isnull(CD.SysTableName,''Com_Address'')
		,GM.IsCalc,CD.ColumnDataType,GM.ValueType,GM.Reference,F.TableName
		FROM INV_GSTMapping GM WITH(NOLOCK)
		LEFT JOIN ADM_CostCenterDef CD WITH(NOLOCK) ON CD.CostCenterID=(CASE WHEN GM.Reference IN (92,93,94) THEN 110 ELSE GM.Reference END) AND CD.SysColumnName=GM.SysColumnName
		LEFT JOIN ADM_Features F WITH(NOLOCK) ON F.FeatureID=(CASE WHEN GM.Reference IN (92,93,94) AND (CD.ColumnCostCenterID IS NULL OR CD.ColumnCostCenterID=0) THEN 110 ELSE CD.ColumnCostCenterID END)
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND GM.ValueType IN (''Seller'',''Buyer'') AND GM.Reference<>0
		
		SELECT @I=1,@ICNT=COUNT(*) FROM #GSTMapping WITH(NOLOCK)
		
		WHILE @I<=@ICNT
		BEGIN
			SELECT @SQL='''',@SysColumnName=SysColumnName,@GSTColumnName=GSTColumnName,@IsCalc=IsCalc,@SysTableName=SysTableName,@DataType=DataType,@ValueType=ValueType,@DefColumnName=DefColumnName,@Reference=Reference
			FROM #GSTMapping WITH(NOLOCK) WHERE ID=@I
			
			IF @Reference=4
			BEGIN
				SET @SQL=''SELECT ''+@SysColumnName+'' FROM PACT2C.dbo.''+@SysTableName+'' WITH(NOLOCK) WHERE CompanyID=''+CONVERT(NVARCHAR,@CompanyID)
				
				IF(@DataType=''LISTBOX'')
				BEGIN
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
			END
			ELSE IF @Reference=2
			BEGIN
				IF NOT EXISTS (SELECT 1 FROM @CCData WHERE Reference=@Reference)
				BEGIN
					INSERT INTO @CCData
					SELECT @Reference,(CASE WHEN MAX(IDD.VoucherType)=-1 THEN MAX(IDD.DebitAccount) ELSE MAX(IDD.CreditAccount) END) 
					FROM INV_DocDetails IDD WITH(NOLOCK)
					WHERE IDD.DocID=@DocID
				END 

				
				IF(@SysTableName=''COM_Address'')
				BEGIN
					SET @SQL=''SELECT TOP 1 ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE FEATUREID=''+CONVERT(NVARCHAR,@Reference)+'' AND FEATUREPK=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
				END
				ELSE IF(@SysColumnName LIKE ''CCNID%'')
				BEGIN
					SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE CostCenterID=''+CONVERT(NVARCHAR,@Reference)+'' AND NodeID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
				ELSE
					SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE AccountID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference)) 
			END
			ELSE IF @Reference IN (92,93,94)
			BEGIN
				IF NOT EXISTS (SELECT * FROM @CCData WHERE Reference=@Reference)
				BEGIN
					INSERT INTO @CCData
					SELECT @Reference,ISNULL((SELECT AddressID FROM COM_DocAddressData WITH(NOLOCK) 
					WHERE DocID=@DocID AND [AddressTypeID]=(CASE WHEN @Reference=92 THEN 1 WHEN @Reference=93 THEN 2 ELSE 3 END )),0)
				END
				
				SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE AddressID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
				IF(@SysColumnName LIKE ''CCNID%'')
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
			END
			ELSE IF @Reference BETWEEN 40001 AND 49999
			BEGIN
				IF(@SysColumnName LIKE ''dcCCNID%'')
				BEGIN
					SET @SQL=''SELECT MAX(ISNULL(DCD.''+@SysColumnName+'','''''''')) FROM INV_DocDetails IDD WITH(NOLOCK)
					JOIN COM_DocCCData DCD WITH(NOLOCK) ON DCD.InvDocDetailsID=IDD.InvDocDetailsID
					WHERE IDD.DocID=''+CONVERT(NVARCHAR,@DocID)
					
					SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
				ELSE IF(@SysColumnName LIKE ''dcAlpha%'')
				BEGIN
					SET @SQL=''SELECT MAX(ISNULL(DTD.''+@SysColumnName+'','''''''')) FROM INV_DocDetails IDD WITH(NOLOCK)
					JOIN COM_DocTextData DTD WITH(NOLOCK) ON DTD.InvDocDetailsID=IDD.InvDocDetailsID
					WHERE IDD.DocID=''+CONVERT(NVARCHAR,@DocID)
					
					IF(@DefColumnName IS NOT NULL OR @DefColumnName<>'''')
						SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
				END
			END
			ELSE IF @Reference>50000
			BEGIN
				IF NOT EXISTS (SELECT 1 FROM @CCData WHERE Reference=@Reference)
				BEGIN
					SET @SQL=''SELECT ''+CONVERT(NVARCHAR,@Reference)+'',MAX(DCD.dcCCNID''+CONVERT(NVARCHAR,(@Reference-50000))+'') FROM INV_DocDetails IDD WITH(NOLOCK)
					JOIN COM_DocCCData DCD WITH(NOLOCK) ON DCD.InvDocDetailsID=IDD.InvDocDetailsID
					WHERE IDD.DocID=''+CONVERT(NVARCHAR,@DocID)
					
					INSERT INTO @CCData
					EXEC (@SQL)
				END
				
				IF(@SysTableName=''COM_Address'')
				BEGIN
					SET @SQL=''SELECT TOP 1 ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE FEATUREID=''+CONVERT(NVARCHAR,@Reference)+'' AND FEATUREPK=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference))
				END
				ELSE
				BEGIN
					SET @SQL=''SELECT ''+@SysColumnName+'' FROM ''+@SysTableName+'' WITH(NOLOCK) WHERE NodeID=''+CONVERT(NVARCHAR,(SELECT NodeID FROM @CCData WHERE Reference=@Reference)) 
					IF(@SysColumnName LIKE ''CCNID%'')
					BEGIN
						SET @SQL=@SQL+'' AND CostCenterID=''+CONVERT(NVARCHAR,@Reference)
						SET @SQL=''SELECT TOP 1 ''+ (CASE WHEN @IsCalc=1 THEN ''Name'' ELSE ''Code'' END) +'' FROM ''+@DefColumnName+'' WITH(NOLOCK) WHERE CONVERT(NVARCHAR,NODEID) =(''+@SQL+'') ''
					END
				END
			END
			
			SET @SQL=''UPDATE #AddDeatils SET ''+REPLACE(REPLACE(@GSTColumnName,''_Seller'',''''),''_Buyer'','''')+''=(''+@SQL+'')
			WHERE AddType''

			IF(@GSTColumnName LIKE ''%_Seller'')
				SET @SQL=@SQL+''=1''
			ELSE IF(@GSTColumnName LIKE ''%_Buyer'')
				SET @SQL=@SQL+''=2''
			ELSE
				SET @SQL=@SQL+'' IN (1,2)''	
			
			PRINT @SQL
			EXEC (@SQL)
			SET @I=@I+1
		END
		
		TRUNCATE TABLE #GSTMapping
		INSERT INTO #GSTMapping
		SELECT DISTINCT GM.SysColumnName,GM.GSTColumnName,F.TableName,GM.IsCalc,CD.ColumnDataType,GM.ValueType,GM.Reference,GM.DefColumnName
		FROM INV_GSTMapping GM WITH(NOLOCK)
		JOIN ADM_CostCenterDef CD WITH(NOLOCK) ON CD.CostCenterID=GM.CostCenterID AND CD.SysColumnName=GM.SysColumnName
		LEFT JOIN ADM_Features F WITH(NOLOCK) ON F.FeatureID=CD.ColumnCostCenterID
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND ValueType NOT IN (''Seller'',''Buyer'')
		UNION 
		SELECT DISTINCT GM.SysColumnName,GM.GSTColumnName,NULL,GM.IsCalc,''FLOAT'',GM.ValueType,GM.Reference,GM.DefColumnName
		FROM INV_GSTMapping GM WITH(NOLOCK)
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND ValueType NOT IN (''Seller'',''Buyer'') AND (GM.SysColumnName=''MULTIPLEFIELDS'' OR GM.SysColumnName=''MULTIPLEFIELDS_Reason'')

		SELECT @I=1,@ICNT=COUNT(*),@TransTabColumns='''',@TransColumns='''',@Columns='''',@JOIN='''' FROM #GSTMapping WITH(NOLOCK)

		WHILE @I<=@ICNT
		BEGIN
			SELECT @SysColumnName=SysColumnName,@GSTColumnName=GSTColumnName,@IsCalc=IsCalc,@SysTableName=SysTableName,@DataType=DataType,@ValueType=ValueType,@DefColumnName=DefColumnName
			FROM #GSTMapping WITH(NOLOCK) WHERE ID=@I
			IF(@SysColumnName=''MULTIPLEFIELDS'')
			BEGIN
				IF @DefColumnName IS NOT NULL AND @DefColumnName<>''''
				BEGIN
					IF(@ValueType=''Transaction'')
					BEGIN
						SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
						IF (@IsCalc=1)
						BEGIN
							IF(@CurrencyType=1)
								SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNumFC'')+'',0)) ''+@GSTColumnName
							ELSE
								SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNum'')+'',0)) ''+@GSTColumnName
						END
						ELSE
							SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.'')+'',0)) ''+@GSTColumnName
					END
					ELSE
					BEGIN
						IF (@IsCalc=1)
						BEGIN
							IF(@CurrencyType=1)
								SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNumFC'')+'',0) ''+@GSTColumnName
							ELSE
								SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNum'')+'',0) ''+@GSTColumnName
						END
						ELSE
							SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.'')+'',0) ''+@GSTColumnName
					END
				END
			END
			ELSE IF(@SysColumnName=''MULTIPLEFIELDS_Reason'')
			BEGIN
				IF @DefColumnName IS NOT NULL AND @DefColumnName<>''''
				BEGIN
					
					TRUNCATE TABLE #MultiField
					INSERT INTO #MultiField
					EXEC SPSplitString @DefColumnName,'','' 
					
					SELECT @J=1,@JCNT=COUNT(*) FROM #MultiField WITH(NOLOCK)
					WHILE @J<=@JCNT
					BEGIN
					
						SELECT @DefColumnName=DefColumnName FROM #MultiField WITH(NOLOCK) WHERE ID=@J
					
						TRUNCATE TABLE #MultiFieldReason
						INSERT INTO #MultiFieldReason
						EXEC SPSplitString @DefColumnName,''~''
						
						
						IF(@ValueType=''Transaction'')
						BEGIN
							SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
							IF (@IsCalc=1)
							BEGIN
								IF(@CurrencyType=1)
									SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNumFC'')+'',0)) ''+@GSTColumnName
								ELSE
									SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.''),''dcNum'',''dcCalcNum'')+'',0)) ''+@GSTColumnName
							END
							ELSE
								SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(@DefColumnName,'','','',0)+ISNULL(DND.'')+'',0)) ''+@GSTColumnName
						END
						ELSE
						BEGIN
							IF (@IsCalc=1)
							BEGIN
								IF(@CurrencyType=1)
									SELECT @Columns=@Columns+'',ISNULL(ISNULL(DND.''+REPLACE(DefColumnName,''dcNum'',''dcCalcNumFC'')+'',DND.''+REPLACE(DefColumnName,''dcNum'',''dcCalcNum'')+''),0) ''
									FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=1
								ELSE
									SELECT @Columns=@Columns+'',ISNULL(DND.''+REPLACE(DefColumnName,''dcNum'',''dcCalcNum'')+'',0) ''
									FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=1
							END
							ELSE
								SELECT @Columns=@Columns+'',ISNULL(DND.''+DefColumnName+'',0) '' 
								FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=1
							SELECT @Columns=@Columns+@GSTColumnName+''_''+CONVERT(NVARCHAR,@J)
							SELECT @Columns=@Columns+'',''''''+DefColumnName+'''''' ''+@GSTColumnName+''_Code_''+CONVERT(NVARCHAR,@J) 
							FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=2
							SELECT @Columns=@Columns+'',''''''+DefColumnName+'''''' ''+@GSTColumnName+''_Reason_''+CONVERT(NVARCHAR,@J) 
							FROM #MultiFieldReason WITH(NOLOCK) WHERE ID=3
						END
					
						SET @J=@J+1
					END 
				END
			END
			ELSE IF(@SysColumnName LIKE ''dcNum%'')
			BEGIN
				IF(@ValueType=''Transaction'')
				BEGIN
					SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
					IF (@IsCalc=1)
					BEGIN
						IF(@CurrencyType=1)
							SET @TransColumns=@TransColumns+'',SUM(ISNULL(ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNumFC'')+'',DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+''),0)) ''+@GSTColumnName
						ELSE
							SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+'',0)) ''+@GSTColumnName
					END
					ELSE
						SET @TransColumns=@TransColumns+'',SUM(ISNULL(DND.''+@SysColumnName+'',0)) ''+@GSTColumnName
				END
				ELSE
				BEGIN
					IF (@IsCalc=1)
					BEGIN
						IF(@CurrencyType=1)
							SET @Columns=@Columns+'',ISNULL(ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNumFC'')+'',DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+''),0) ''+@GSTColumnName
						ELSE
							SET @Columns=@Columns+'',ISNULL(DND.''+REPLACE(@SysColumnName,''dcNum'',''dcCalcNum'')+'',0) ''+@GSTColumnName
					END
					ELSE
						SET @Columns=@Columns+'',ISNULL(DND.''+@SysColumnName+'',0) ''+@GSTColumnName
				END
			END
			ELSE IF(@SysColumnName LIKE ''dcCCNID%'' AND @SysTableName IS NOT NULL AND @SysTableName<>'''')
			BEGIN
				SET @Columns=@Columns+'',CASE WHEN CC''+CONVERT(NVARCHAR,@I)+''.NodeID>1 THEN CC''+CONVERT(NVARCHAR,@I)+ (CASE WHEN @IsCalc=1 THEN ''.Name '' ELSE ''.Code '' END)+''ELSE '''''''' END '' +@GSTColumnName
				
				IF @GSTColumnName=''VATCategory''
				BEGIN
					SET @Columns=@Columns+'',CASE WHEN CC''+CONVERT(NVARCHAR,@I)+''.NodeID>1 THEN CC''+CONVERT(NVARCHAR,@I)+ (CASE WHEN @IsCalc=0 THEN ''.Name '' ELSE ''.Code '' END)+''ELSE '''''''' END '' +@GSTColumnName+''_Code''
					SET @Columns=@Columns+'',CASE WHEN CC''+CONVERT(NVARCHAR,@I)+''.NodeID>1 THEN CC''+CONVERT(NVARCHAR,@I)+''.AliasName ELSE '''''''' END '' +@GSTColumnName+''_Reason''				
				END
					
				SET @JOIN=@JOIN+'' JOIN ''+@SysTableName+'' CC''+CONVERT(NVARCHAR,@I)+'' WITH(NOLOCK) ON CC''+CONVERT(NVARCHAR,@I)+''.NodeID=DCD.''+@SysColumnName
			END
			ELSE IF(@SysColumnName LIKE ''dcAlpha%'')
			BEGIN
				IF(@SysTableName IS NULL OR @SysTableName='''')
					SET @Columns=@Columns+'',DTD.''+@SysColumnName+'' ''+@GSTColumnName
				ELSE
				BEGIN
					SET @Columns=@Columns+'',CC''+CONVERT(NVARCHAR,@I)+ (CASE WHEN @IsCalc=1 THEN ''.Name '' ELSE ''.Code '' END) + @GSTColumnName
					SET @JOIN=@JOIN+'' LEFT JOIN ''+@SysTableName+'' CC''+CONVERT(NVARCHAR,@I)+'' WITH(NOLOCK) ON CONVERT(NVARCHAR,CC''+CONVERT(NVARCHAR,@I)+''.NodeID)=DTD.''+@SysColumnName
				END
			END
			ELSE 
			BEGIN
				IF (@DataType LIKE ''DATE%'')
					SET @Columns=@Columns+'',CONVERT(DATETIME,IDD.''+@SysColumnName+'') ''+@GSTColumnName
				ELSE IF(@SysColumnName=''ProductID'')
				BEGIN
					SET @Columns=@Columns+ '',PR.Product''+ (CASE WHEN @IsCalc=1 THEN ''Name '' ELSE ''Code '' END) +@GSTColumnName
				END
				ELSE IF(@SysColumnName=''Net'' AND @ValueType=''Transaction'')
				BEGIN
					SET @TransTabColumns=@TransTabColumns+'',''+@GSTColumnName
					SET @TransColumns=@TransColumns+'',SUM(ISNULL(IDD.''+@SysColumnName+'',0)) ''+@GSTColumnName
				END
				ELSE IF(@GSTColumnName=''Rate'')
					SET @Columns=@Columns+'',IDD.''+@SysColumnName+'' ''+@GSTColumnName
				ELSE IF(@GSTColumnName=''Gross'')
				BEGIN
					IF(@CurrencyType=1)
						SET @Columns=@Columns+'',IDD.''+@SysColumnName+''FC ''+@GSTColumnName
					ELSE
						SET @Columns=@Columns+'',IDD.''+@SysColumnName+'' ''+@GSTColumnName
				END
				ELSE
					SET @Columns=@Columns+'',IDD.''+@SysColumnName+'' ''+@GSTColumnName
			END
			SET @I=@I+1
		END

		DECLARE @DocumentType INT
		SET @SQL=''SELECT ''
		SELECT @SysColumnName=DocumentName,@DocumentType=DocumentType FROM ADM_DocumentTypes WITH(NOLOCK) WHERE CostCenterID=@CostCenterID
		
		SET @SQL=@SQL+''''''''+(CASE WHEN (@SysColumnName LIKE ''%CREDIT%'' OR @DocumentType IN (6,39)) THEN ''Credit note'' WHEN @SysColumnName LIKE ''%DEBIT%'' THEN ''Debit note'' WHEN @SysColumnName LIKE ''%PAYMENT%'' THEN ''Prepayment Invoice'' ELSE ''Tax invoice'' END)+'''''' Invoice,''
		
		SET @SQL=@SQL+''IDD.DocID,IDD.VoucherNo,IDD.DocNumber,DID.[GUID],CONVERT(DATETIME,IDD.DocDate) DocDate,CONVERT(DATETIME,IDD.CreatedDate) IssueTime,IDD.DocSeqNo
		,IDD.Quantity,UM.UnitName,1 UOMConversion,UM.UnitName BaseName
		,CU.Code CurrencyCode
		,''''SAR'''' TaxCurrencyCode,IDD.ExchangeRate
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.Identification ELSE BA.Identification END) Identification_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.SchemeID ELSE BA.SchemeID END) SchemeID_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.BuildingNumber ELSE BA.BuildingNumber END) BuildingNumber_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.PlotIdentification ELSE BA.PlotIdentification END) PlotIdentification_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.StreetName ELSE BA.StreetName END) StreetName_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.AdditionalStreetName ELSE BA.AdditionalStreetName END) AdditionalStreetName_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.CityName ELSE BA.CityName END) CityName_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.District ELSE BA.District END) District_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.PostalZone ELSE BA.PostalZone END) PostalZone_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.Country ELSE BA.Country END) Country_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.CountrySubentityCode ELSE BA.CountrySubentityCode END) CountrySubentityCode_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.VATNumber ELSE BA.VATNumber END) VATNumber_Seller
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN SA.RegistrationName ELSE BA.RegistrationName END) RegistrationName_Seller
		
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.Identification ELSE SA.Identification END) Identification_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.SchemeID ELSE SA.SchemeID END) SchemeID_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.BuildingNumber ELSE SA.BuildingNumber END) BuildingNumber_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.PlotIdentification ELSE SA.PlotIdentification END) PlotIdentification_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.StreetName ELSE SA.StreetName END) StreetName_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.AdditionalStreetName ELSE SA.AdditionalStreetName END) AdditionalStreetName_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.CityName ELSE SA.CityName END) CityName_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.District ELSE SA.District END) District_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.PostalZone ELSE SA.PostalZone END) PostalZone_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.Country ELSE SA.Country END) Country_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.CountrySubentityCode ELSE SA.CountrySubentityCode END) CountrySubentityCode_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.VATNumber ELSE SA.VATNumber END) VATNumber_Buyer
		,(CASE WHEN IDD.VoucherType=-1 OR IDD.DocumentType IN (6,39) THEN BA.RegistrationName ELSE SA.RegistrationName END) RegistrationName_Buyer
		''
		SET @SQL=@SQL+@Columns
		SET @SQL=@SQL+'' FROM INV_DocDetails IDD WITH(NOLOCK)
			JOIN COM_DocID DID WITH(NOLOCK) ON DID.ID=IDD.DocID
			JOIN COM_UOM UM WITH(NOLOCK) ON UM.UOMID=IDD.Unit
			JOIN COM_Currency CU WITH(NOLOCK) ON CU.CurrencyID=IDD.CurrencyID
			JOIN COM_DocNumData DND WITH(NOLOCK) ON DND.InvDocDetailsID=IDD.InvDocDetailsID
			JOIN COM_DocCCData DCD WITH(NOLOCK) ON DCD.InvDocDetailsID=IDD.InvDocDetailsID
			JOIN COM_DocTextData DTD WITH(NOLOCK) ON DTD.InvDocDetailsID=IDD.InvDocDetailsID 
			JOIN INV_Product PR WITH(NOLOCK) ON PR.ProductID=IDD.ProductID 
			JOIN #AddDeatils SA WITH(NOLOCK) ON SA.DocID=IDD.DocID AND SA.AddType=1
			JOIN #AddDeatils BA WITH(NOLOCK) ON BA.DocID=IDD.DocID AND BA.AddType=2 ''
		SET @SQL=@SQL+@JOIN
		SET @SQL=@SQL+'' WHERE IDD.DocID=''+CONVERT(NVARCHAR,@DocID)+'' AND IDD.StatusID=369 AND IDD.Quantity>0 AND (IDD.IsQtyFreeOffer=0 OR IDD.ParentSchemeID IS NULL) AND IDD.DynamicInvDocDetailsID IS NULL''

		PRINT @SQL
		PRINT SUBSTRING(@SQL,4001,4000)
		EXEC (@SQL)
		
		SET @IsCalc=0
		IF EXISTS (SELECT *
		FROM INV_GSTMapping GM WITH(NOLOCK)
		WHERE GM.CostCenterID=@CostCenterID AND GM.GSTType=@GSTType AND ValueType=''Items'' AND GSTColumnName IN (''RefDocNo'',''RefDocDate'') AND IsCalc=1)
			SET @IsCalc=1

		SELECT DISTINCT LIDD.VoucherNo RefDocNo,CONVERT(DATETIME,LIDD.DocDate) RefDocDate,@IsCalc IsCalc
		FROM INV_DocDetails IDD WITH(NOLOCK)
		JOIN INV_DocDetails LIDD WITH(NOLOCK) ON IDD.LinkedInvDocDetailsID=LIDD.InvDocDetailsID
		WHERE IDD.DocID=@DocID AND IDD.LinkedInvDocDetailsID>0
		
		DROP TABLE #MultiField
		DROP TABLE #MultiFieldReason
		DROP TABLE #GSTMapping
		DROP TABLE #AddDeatils

COMMIT TRANSACTION    
SET NOCOUNT OFF;    
return 1
END TRY    
BEGIN CATCH      
 --Return exception info [Message,Number,ProcedureName,LineNumber]      
 IF ERROR_NUMBER()=50000    
 BEGIN    
  SELECT ErrorMessage,ErrorNumber FROM COM_ErrorMessages WITH(nolock) WHERE ErrorNumber=ERROR_MESSAGE() AND LanguageID=@LangID    
 END    
 ELSE    
 BEGIN    
  SELECT ErrorMessage, ERROR_MESSAGE() AS ServerMessage,ERROR_NUMBER() as ErrorNumber, ERROR_PROCEDURE()as ProcedureName, ERROR_LINE() AS ErrorLine    
  FROM COM_ErrorMessages WITH(nolock) WHERE ErrorNumber=-999 AND LanguageID=@LangID    
 END    
ROLLBACK TRANSACTION    
SET NOCOUNT OFF      
RETURN -999       
END CATCH     
		
--exec spDOC_GetUBLDetails 410,40011,''UBL'',1 ,1,1







' 
END
GO
