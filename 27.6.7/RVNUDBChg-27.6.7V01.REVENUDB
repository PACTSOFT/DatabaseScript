--CHARY

Update ADM_DashBoard
SET DashboardName=SUBSTRING(DashboardName,4,LEN(DashboardName)-3)+'_PR',
	ReportName=SUBSTRING(ReportName,4,LEN(ReportName)-3)+'_PR',
	CompanyGUID='CGUID',GUID='GUID'
WHERE DashboardName LIKE 'PR_%' AND NodeID<0


Update ADM_Widgets
SET Name=SUBSTRING(Name,4,LEN(Name)-3)+'_PR'
WHERE Name LIKE 'PR_%' AND ID<0


SET IDENTITY_INSERT [dbo].[COM_Config] ON
