    CREATE TABLE #DirectPlan
    (
        RibbonViewId          int            NOT NULL PRIMARY KEY,
        FeatureId             int            NOT NULL,
        FeatureName           nvarchar(500)  NULL,
        FeatureCategory       varchar(40)    NOT NULL,
        CurrentWebIcon        varchar(500)   NULL,
        SyntaxEra             varchar(30)    NOT NULL,
        DetectedStyle         varchar(30)    NOT NULL,
        ParsedIconName        varchar(150)   NULL,
        BaseNameStatus        varchar(40)    NOT NULL,
        CanonicalFA6IconName  varchar(150)   NULL,
        SuggestedWebIcon      varchar(220)   NULL,
        AlternativeWebIcon    varchar(220)   NULL,
        ReplacementWebIcon    varchar(220)   NULL,
        Action                varchar(180)   NOT NULL
    );

    ;WITH Live AS
    (
        SELECT
            RV.RibbonViewId,
            RV.FeatureId,
            F.Name AS FeatureName,
            M.FeatureCategory,
            RV.WebIcon,
            M.SuggestedWebIcon,
            M.AlternativeWebIcon
        FROM dbo.ADM_RibbonView RV
        INNER JOIN dbo.ADM_Features F
            ON F.FeatureId = RV.FeatureId
        INNER JOIN #FeatureIconMap M
            ON M.FeatureId = RV.FeatureId
    )
    INSERT INTO #DirectPlan
    (
        RibbonViewId, FeatureId, FeatureName, FeatureCategory,
        CurrentWebIcon, SyntaxEra, DetectedStyle, ParsedIconName,
        BaseNameStatus, CanonicalFA6IconName,
        SuggestedWebIcon, AlternativeWebIcon,
        ReplacementWebIcon, Action
    )
    SELECT
        L.RibbonViewId,
        L.FeatureId,
        L.FeatureName,
        L.FeatureCategory,
        L.WebIcon,
        ParseInfo.SyntaxEra,
        ParseInfo.DetectedStyle,
        Parsed.IconName,

        CASE
            WHEN MissingInfo.IsMissing = 1 THEN 'MISSING'
            WHEN Brand.CanonicalName IS NOT NULL THEN 'BRAND'
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A4.CanonicalFA6Name IS NOT NULL THEN 'V4_ALIAS'
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A5.CanonicalFA6Name IS NOT NULL THEN 'V5_ALIAS'
            WHEN ParseInfo.SyntaxEra <> 'FA4_LEGACY'
                 AND A4Any.CanonicalFA6Name IS NOT NULL THEN 'V4_ALIAS'
            WHEN A5.CanonicalFA6Name IS NOT NULL THEN 'V5_ALIAS'
            WHEN InvalidName.IconName IS NOT NULL THEN 'INVALID_FA6_BASE_NAME'
            WHEN Native.IconName IS NOT NULL THEN 'FA6_NATIVE'
            WHEN Parsed.IconName IS NULL THEN 'MALFORMED'
            ELSE 'UNVERIFIED_PRO_OR_CUSTOM'
        END,

        CASE
            WHEN Brand.CanonicalName IS NOT NULL THEN Brand.CanonicalName
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A4.CanonicalFA6Name IS NOT NULL THEN A4.CanonicalFA6Name
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A5.CanonicalFA6Name IS NOT NULL THEN A5.CanonicalFA6Name
            WHEN ParseInfo.SyntaxEra <> 'FA4_LEGACY'
                 AND A4Any.CanonicalFA6Name IS NOT NULL THEN A4Any.CanonicalFA6Name
            WHEN A5.CanonicalFA6Name IS NOT NULL THEN A5.CanonicalFA6Name
            WHEN InvalidName.IconName IS NOT NULL THEN NULL
            WHEN Native.IconName IS NOT NULL THEN Native.IconName
            ELSE Parsed.IconName
        END,

        L.SuggestedWebIcon,
        L.AlternativeWebIcon,

        CASE
            /* Missing normal/main -> approved feature suggestion. */
            WHEN MissingInfo.IsMissing = 1
                THEN L.SuggestedWebIcon

            /* Brands always use Brands family. */
            WHEN Brand.CanonicalName IS NOT NULL
                 AND
                 (
                    ParseInfo.DetectedStyle <> 'BRANDS'
                    OR Parsed.IconName <> Brand.CanonicalName
                 )
                THEN 'fa-brands fa-' + Brand.CanonicalName

            /* FA4 syntax: official v4 alias. */
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A4.CanonicalFA6Name IS NOT NULL
                THEN 'fa-light fa-' + A4.CanonicalFA6Name

            /* FA4 syntax containing a name later renamed in v6. */
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A5.CanonicalFA6Name IS NOT NULL
                THEN 'fa-light fa-' + A5.CanonicalFA6Name

            /* Native name but old generic FA4 prefix: preserve identity. */
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND Native.IconName IS NOT NULL
                THEN 'fa-light fa-' + Native.IconName

            /* Modern prefix but v4-only compatibility alias in the base name. */
            WHEN ParseInfo.SyntaxEra <> 'FA4_LEGACY'
                 AND A4Any.CanonicalFA6Name IS NOT NULL
                THEN 'fa-light fa-' + A4Any.CanonicalFA6Name

            /* Modern prefix using a v5 name renamed in v6. */
            WHEN A5.CanonicalFA6Name IS NOT NULL
                THEN 'fa-light fa-' + A5.CanonicalFA6Name

            /* Confirmed invalid/nonexistent FA6 base name. */
            WHEN InvalidName.IconName IS NOT NULL
                THEN L.SuggestedWebIcon

            /* Native modern FA6 pair: keep. */
            WHEN Native.IconName IS NOT NULL
                 AND ParseInfo.DetectedStyle IN
                     ('SOLID','REGULAR','LIGHT','THIN','BRANDS')
                THEN NULL

            WHEN Native.IconName IS NOT NULL
                THEN 'fa-light fa-' + Native.IconName


            ELSE NULL
        END,

        CASE
            WHEN MissingInfo.IsMissing = 1
                THEN 'FILL MISSING ICON WITH SUGGESTED'
            WHEN Brand.CanonicalName IS NOT NULL
                 AND
                 (
                    ParseInfo.DetectedStyle <> 'BRANDS'
                    OR Parsed.IconName <> Brand.CanonicalName
                 )
                THEN 'REPAIR BRAND FAMILY/NAME'
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A4.CanonicalFA6Name IS NOT NULL
                THEN 'CANONICALIZE V4 ALIAS TO NATIVE FA6 PRO LIGHT'
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND A5.CanonicalFA6Name IS NOT NULL
                THEN 'CANONICALIZE V5 ALIAS TO NATIVE FA6 PRO LIGHT'
            WHEN ParseInfo.SyntaxEra = 'FA4_LEGACY'
                 AND Native.IconName IS NOT NULL
                THEN 'NORMALIZE LEGACY PREFIX; PRESERVE ICON IDENTITY'
            WHEN ParseInfo.SyntaxEra <> 'FA4_LEGACY'
                 AND A4Any.CanonicalFA6Name IS NOT NULL
                THEN 'CANONICALIZE V4 BASE ALIAS TO NATIVE FA6 PRO LIGHT'
            WHEN A5.CanonicalFA6Name IS NOT NULL
                THEN 'CANONICALIZE V5 BASE ALIAS TO NATIVE FA6 PRO LIGHT'
            WHEN InvalidName.IconName IS NOT NULL
                THEN 'REPLACE INVALID/NONEXISTENT FA6 BASE NAME WITH SUGGESTED'

            WHEN Native.IconName IS NOT NULL
                 AND ParseInfo.DetectedStyle IN
                     ('SOLID','REGULAR','LIGHT','THIN','BRANDS')
                THEN 'KEEP VALID NATIVE FA6 ICON'
            WHEN Native.IconName IS NOT NULL
                THEN 'REPAIR PREFIX; PRESERVE ICON IDENTITY'
            WHEN Parsed.IconName IS NULL
                THEN 'MANUAL REVIEW - UNPARSEABLE'
            ELSE
                'MANUAL REVIEW - UNVERIFIED PRO/CUSTOM BASE NAME'
        END

    FROM Live L

    OUTER APPLY
    (
        SELECT CASE
            WHEN L.WebIcon IS NULL
              OR LTRIM(RTRIM(L.WebIcon)) = ''
              OR UPPER(LTRIM(RTRIM(L.WebIcon))) IN ('NULL','N/A','NA','NONE')
            THEN 1 ELSE 0 END AS IsMissing
    ) MissingInfo

    OUTER APPLY
    (
        SELECT
            CASE
                WHEN ' ' + LTRIM(RTRIM(ISNULL(L.WebIcon,''))) + ' '
                     LIKE '% fa %'
                     AND LTRIM(RTRIM(ISNULL(L.WebIcon,''))) NOT LIKE 'fa-%'
                    THEN 'FA4_LEGACY'
                ELSE 'CURRENT_OR_SHORTHAND'
            END AS SyntaxEra,

            CASE
                WHEN L.WebIcon LIKE '%fa-brands%' OR
                     LTRIM(RTRIM(ISNULL(L.WebIcon,''))) LIKE 'fab %'
                    THEN 'BRANDS'
                WHEN L.WebIcon LIKE '%fa-light%' OR
                     LTRIM(RTRIM(ISNULL(L.WebIcon,''))) LIKE 'fal %'
                    THEN 'LIGHT'
                WHEN L.WebIcon LIKE '%fa-regular%' OR
                     LTRIM(RTRIM(ISNULL(L.WebIcon,''))) LIKE 'far %'
                    THEN 'REGULAR'
                WHEN L.WebIcon LIKE '%fa-thin%' OR
                     LTRIM(RTRIM(ISNULL(L.WebIcon,''))) LIKE 'fat %'
                    THEN 'THIN'
                WHEN L.WebIcon LIKE '%fa-solid%' OR
                     LTRIM(RTRIM(ISNULL(L.WebIcon,''))) LIKE 'fas %'
                    THEN 'SOLID'
                WHEN ' ' + LTRIM(RTRIM(ISNULL(L.WebIcon,''))) + ' '
                     LIKE '% fa %'
                    THEN 'LEGACY_FA'
                ELSE 'UNKNOWN'
            END AS DetectedStyle
    ) ParseInfo

    OUTER APPLY
(
    SELECT TOP (1)
        SUBSTRING(S.IconValue, 4, 150) AS IconName
    FROM
    (
        SELECT
            X.N.value('.', 'VARCHAR(150)') AS IconValue
        FROM
        (
            SELECT CAST(
                '<X>' +
                REPLACE(
                    LTRIM(RTRIM(ISNULL(L.WebIcon, ''))),
                    ' ',
                    '</X><X>'
                ) +
                '</X>' AS XML
            ) AS XmlData
        ) D
        CROSS APPLY D.XmlData.nodes('/X') X(N)
    ) S
    WHERE S.IconValue LIKE 'fa-%'
      AND S.IconValue NOT IN
      (
          'fa-classic','fa-solid','fa-regular','fa-light','fa-thin',
          'fa-brands','fa-duotone','fa-sharp','fa-sharp-duotone',
          'fa-fw','fa-border','fa-spin','fa-pulse','fa-beat','fa-fade',
          'fa-beat-fade','fa-bounce','fa-flip','fa-shake',
          'fa-spin-pulse','fa-spin-reverse','fa-2xs','fa-xs','fa-sm',
          'fa-lg','fa-xl','fa-2xl','fa-1x','fa-2x','fa-3x','fa-4x',
          'fa-5x','fa-6x','fa-7x','fa-8x','fa-9x','fa-10x'
      )
    ORDER BY LEN(S.IconValue) DESC
) Parsed
    LEFT JOIN #FA4AliasMap A4
        ON A4.AliasName = Parsed.IconName

    LEFT JOIN #FA4AliasAnyPrefix A4Any
        ON A4Any.AliasName = Parsed.IconName

    LEFT JOIN #FA5AliasMap A5
        ON A5.AliasName = Parsed.IconName

    LEFT JOIN #BrandIconMap Brand
        ON Brand.AliasName = Parsed.IconName

    LEFT JOIN #KnownInvalidFA6BaseName InvalidName
        ON InvalidName.IconName = Parsed.IconName

    LEFT JOIN #VerifiedNativeFA6Name Native
        ON Native.IconName = Parsed.IconName;

    ;WITH MainDocumentRaw AS
    (
        SELECT
            DT.DocumentType,
            DT.CostCenterID AS MainFeatureId,
            F.Name AS MainFeatureName
        FROM dbo.ADM_DocumentTypes DT
        INNER JOIN dbo.ADM_Features F
            ON F.FeatureId = DT.CostCenterID
        WHERE F.ParentFeatureId = 400
          AND DT.CostCenterID BETWEEN 40001 AND 40999
    ),
    MainUnique AS
    (
        SELECT
            DocumentType,
            MIN(MainFeatureId) AS MainFeatureId,
            COUNT(DISTINCT MainFeatureId) AS MainCount
        FROM MainDocumentRaw
        GROUP BY DocumentType
    ),
    MainEffectiveIcon AS
    (
        SELECT
            U.DocumentType,
            U.MainFeatureId,
            MAX(F.Name) AS MainFeatureName,
            MIN
            (
                CASE
                    WHEN COALESCE(NULLIF(LTRIM(RTRIM(P.ReplacementWebIcon)), ''), RV.WebIcon) IS NULL
                      OR LTRIM(RTRIM(COALESCE(P.ReplacementWebIcon, RV.WebIcon))) = ''
                      OR UPPER(LTRIM(RTRIM(COALESCE(P.ReplacementWebIcon, RV.WebIcon))))
                           IN ('NULL','N/A','NA','NONE')
                    THEN NULL
                    ELSE COALESCE(P.ReplacementWebIcon, RV.WebIcon)
                END
            ) AS EffectiveMainWebIcon,
            COUNT
            (
                DISTINCT
                CASE
                    WHEN COALESCE(NULLIF(LTRIM(RTRIM(P.ReplacementWebIcon)), ''), RV.WebIcon) IS NULL
                      OR LTRIM(RTRIM(COALESCE(P.ReplacementWebIcon, RV.WebIcon))) = ''
                      OR UPPER(LTRIM(RTRIM(COALESCE(P.ReplacementWebIcon, RV.WebIcon))))
                           IN ('NULL','N/A','NA','NONE')
                    THEN NULL
                    ELSE COALESCE(P.ReplacementWebIcon, RV.WebIcon)
                END
            ) AS DistinctUsableMainIconCount
        FROM MainUnique U
        INNER JOIN dbo.ADM_Features F
            ON F.FeatureId = U.MainFeatureId
        LEFT JOIN dbo.ADM_RibbonView RV
            ON RV.FeatureId = U.MainFeatureId
        LEFT JOIN #DirectPlan P
            ON P.RibbonViewId = RV.RibbonViewId
        WHERE U.MainCount = 1
        GROUP BY U.DocumentType, U.MainFeatureId
    )
    SELECT
        ChildRV.RibbonViewId,
        ChildF.FeatureId AS ChildFeatureId,
        ChildF.Name AS ChildFeatureName,
        ChildDT.DocumentType,
        MEI.MainFeatureId,
        MEI.MainFeatureName,
        ChildRV.WebIcon AS CurrentChildWebIcon,
        MEI.EffectiveMainWebIcon AS RequiredChildWebIcon,
        FM.SuggestedWebIcon,
        FM.AlternativeWebIcon,

        CASE
            WHEN MEI.DistinctUsableMainIconCount <> 1
                THEN 'BLOCKED - MAIN ICON NOT UNIQUE/USABLE'
            WHEN NULLIF(LTRIM(RTRIM(MEI.EffectiveMainWebIcon)), '') IS NULL
                THEN 'BLOCKED - MAIN ICON MISSING'
            WHEN ChildRV.WebIcon IS NULL
              OR LTRIM(RTRIM(ChildRV.WebIcon)) = ''
              OR UPPER(LTRIM(RTRIM(ChildRV.WebIcon)))
                   IN ('NULL','N/A','NA','NONE')
                THEN 'FILL EMPTY CHILD ICON FROM MAIN'
            ELSE
                'KEEP EXISTING CHILD ICON'
        END AS ChildAction

    INTO #ChildDocumentPlan

    FROM dbo.ADM_RibbonView ChildRV
    INNER JOIN dbo.ADM_Features ChildF
        ON ChildF.FeatureId = ChildRV.FeatureId
    INNER JOIN dbo.ADM_DocumentTypes ChildDT
        ON ChildDT.CostCenterID = ChildF.FeatureId
    INNER JOIN MainEffectiveIcon MEI
        ON MEI.DocumentType = ChildDT.DocumentType
    LEFT JOIN #FeatureIconMap FM
        ON FM.FeatureId = MEI.MainFeatureId
    WHERE ChildF.ParentFeatureId = 400
      AND ChildF.FeatureId >= 41000;

    IF @ApplyChanges = 0
    BEGIN
        SELECT
            RibbonViewId,
            FeatureId,
            FeatureName,
            FeatureCategory,
            CurrentWebIcon,
            SyntaxEra,
            DetectedStyle,
            ParsedIconName,
            BaseNameStatus,
            CanonicalFA6IconName,
            SuggestedWebIcon,
            AlternativeWebIcon,
            ReplacementWebIcon,
            Action
        FROM #DirectPlan
        ORDER BY
            CASE WHEN ReplacementWebIcon IS NULL THEN 1 ELSE 0 END,
            FeatureId,
            RibbonViewId;

        SELECT *
        FROM #ChildDocumentPlan
        ORDER BY DocumentType, MainFeatureId, ChildFeatureId, RibbonViewId;

        ROLLBACK TRANSACTION;
        RETURN;
    END;


    DECLARE @DirectUpdated int = 0;
    DECLARE @ChildUpdated int = 0;

    UPDATE RV
       SET RV.WebIcon = P.ReplacementWebIcon
    FROM dbo.ADM_RibbonView RV
    INNER JOIN #DirectPlan P
        ON P.RibbonViewId = RV.RibbonViewId
    WHERE P.ReplacementWebIcon IS NOT NULL
      AND NULLIF(LTRIM(RTRIM(P.ReplacementWebIcon)), '') IS NOT NULL
      AND ISNULL(RV.WebIcon, '') <> ISNULL(P.ReplacementWebIcon, '');

    SET @DirectUpdated = @@ROWCOUNT;

    UPDATE ChildRV
       SET ChildRV.WebIcon = CP.RequiredChildWebIcon
    FROM dbo.ADM_RibbonView ChildRV
    INNER JOIN #ChildDocumentPlan CP
        ON CP.RibbonViewId = ChildRV.RibbonViewId
    WHERE CP.ChildAction = 'FILL EMPTY CHILD ICON FROM MAIN'
      AND NULLIF(LTRIM(RTRIM(CP.RequiredChildWebIcon)), '') IS NOT NULL
      AND
      (
           ChildRV.WebIcon IS NULL
        OR LTRIM(RTRIM(ChildRV.WebIcon)) = ''
        OR UPPER(LTRIM(RTRIM(ChildRV.WebIcon)))
             IN ('NULL','N/A','NA','NONE')
      );

    SET @ChildUpdated = @@ROWCOUNT;

    COMMIT TRANSACTION;

    PRINT 'Font Awesome 6 Pro native icon remediation completed.';
    PRINT 'Direct/main rows updated: ' + CAST(@DirectUpdated AS varchar(20));
    PRINT 'Missing child rows filled: ' + CAST(@ChildUpdated AS varchar(20));

	IF OBJECT_ID('TEMPDB..#ChangeDocumentPlan') IS NOT NULL 
	  DROP TABLE #ChangeDocumentPlan

	IF OBJECT_ID('TEMPDB..#FeatureIconMap') IS NOT NULL 
	  DROP TABLE #FeatureIconMap

	IF OBJECT_ID('TEMPDB..#FA4AliasMap') IS NOT NULL 
	  DROP TABLE #FA4AliasMap

	IF OBJECT_ID('TEMPDB..#FA4AliasAnyPrefix') IS NOT NULL 
	  DROP TABLE #FA4AliasAnyPrefix

	IF OBJECT_ID('TEMPDB..#FA5AliasMap') IS NOT NULL 
	  DROP TABLE #FA5AliasMap

	IF OBJECT_ID('TEMPDB..#BrandIconMap') IS NOT NULL 
	  DROP TABLE #BrandIconMap

	IF OBJECT_ID('TEMPDB..#VerifiedNativeFA6Name') IS NOT NULL 
	  DROP TABLE #VerifiedNativeFA6Name

	IF OBJECT_ID('TEMPDB..#KnownInvalidFA6BaseName') IS NOT NULL 
	  DROP TABLE #KnownInvalidFA6BaseName


	IF OBJECT_ID('TEMPDB..#DirectPlan') IS NOT NULL 
	  DROP TABLE #DirectPlan

	 
	IF OBJECT_ID('TEMPDB..#ChildDocumentPlan') IS NOT NULL 
	  DROP TABLE #ChildDocumentPlan


END TRY
BEGIN CATCH
    IF @@TRANCOUNT > 0
        ROLLBACK TRANSACTION;
    THROW;
END CATCH;



