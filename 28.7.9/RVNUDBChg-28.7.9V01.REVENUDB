DECLARE @Rid  INT 
SELECT @Rid=MAX(ResourceID) from COM_LanguageResources WITH(NOLOCK)
SET @Rid=@Rid+1
IF NOT EXISTS(SELECT Name FROM [ADM_GlobalPreferences] WITH(NOLOCK) WHERE  Name='PasswordletterLegth')
BEGIN
	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@Rid,'PwdMinLength',1,'English','Password Min Length','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',convert(float,getdate()),NULL,NULL,'')

	INSERT INTO [com_languageresources] ([ResourceID],[ResourceName],[LanguageID],[LanguageName],[ResourceData],[GUID],[Description],[CreatedBy],[CreatedDate],[ModifiedBy],[ModifiedDate],[FEATURE])
	VALUES(@RId,'PwdMinLength',2,'Arabic',N'Password Min Length-AR','A18AA097-DF5D-41CD-9AFF-22C66D20097A',NULL,'ADMIN',convert(float,getdate()),NULL,NULL,'')


	INSERT [dbo].[ADM_GlobalPreferences] ([ResourceID], [Name], [Value], [DefaultValue], [GUID], [Description], [CreatedBy], [CreatedDate], [ModifiedBy], [ModifiedDate], [PreferenceTypeName], [PrefRowOrder], [PrefColOrder], [PrefValueType], [Version]) 
	VALUES ( @RId, N'PwdMinLength', N'8', N'8 ', N'guid', NULL, N'admin', 44770.980330478393, N'Admin', 44770.980330478393, N'Settings', 112, 0, N'TextBox', 1)

	END

	
